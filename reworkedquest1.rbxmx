				<Item class="ImageLabel" referent="RBX8B46C8DBDDB147BAA08C700D195C39D3">
					<Properties>
						<Content name="Image"><url>rbxassetid://9740907959</url></Content>
						<Color3 name="ImageColor3">
							<R>0.137254909</R>
