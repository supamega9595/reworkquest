						<Item class="Script" referent="RBXCEE3448306EA4A67A5A0B1A9A1F1502A">
							<Properties>
								<ProtectedString name="Source"><![CDATA[-- Script by XcorrectTheDev

local MaxDistance = script.Parent.Parent.Parent.Parent.MaxDistance.Value
local Tool = script.Parent.Parent.Parent.Parent.Handle
local Target = workspace:WaitForChild("DeployedFredbearSystem"):WaitForChild("Fredbear") --Change Dummy to whatever NPC you want.

while wait(1) do
	local DisMagnitude = (Tool.Position - Target.Position).magnitude
	script.Parent.Text = math.floor(DisMagnitude)
	if DisMagnitude > MaxDistance then
	script.Parent.Text = "Signal Lost"
	Tool.Sound.Looped = false
	Tool.Sound:Play()
	Tool.Parent.Light.Color = Color3.fromRGB(255,255,255)
	Tool.Sound.PlaybackSpeed = 0.8
	end
	if DisMagnitude < MaxDistance and DisMagnitude > 120 then
	script.Parent.Text = math.floor(DisMagnitude)
	Tool.Sound:Play()
	Tool.Sound.Looped = false
	Tool.Parent.Light.Color = Color3.fromRGB(255,175,0)
	Tool.Sound.PlaybackSpeed = 1
	end
	if DisMagnitude < 120 and DisMagnitude > 50 then
	script.Parent.Text = "!! ".. math.floor(DisMagnitude) .." !!"
	Tool.Sound.PlaybackSpeed = 1.2	
	Tool.Sound.Looped = true
	Tool.Parent.Light.Color = Color3.fromRGB(255,85,0)
	if not Tool.Sound.IsPlaying then
	Tool.Sound:Play()
	end
	end	
	if DisMagnitude < 50 then
	script.Parent.Text = "!!! ".. math.floor(DisMagnitude) .." !!!"
	Tool.Sound.Looped = true
	Tool.Sound.PlaybackSpeed = 1.4	
	Tool.Parent.Light.Color = Color3.fromRGB(255,0,0)
	if not Tool.Sound.IsPlaying then
	Tool.Sound:Play()
	end
	end	
end]]></ProtectedString>
