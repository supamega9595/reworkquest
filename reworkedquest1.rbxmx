local sounds = {}
local function playOneShot(soundId)
	local s = sounds[soundId]
	if not s then
		s = Instance.new("Sound")
		s.SoundId = soundId
		s.Volume = 0.8
		s.Parent = gui
		sounds[soundId] = s
	end
	s:Stop()
	s.TimePosition = 0
	s:Play()
end

local currentPercent = 0
local currentlyVisible = false
local completedFlashThread
local activePulseToken = 0

local function threatTier(threatPercent)
	if threatPercent >= 0.85 then
		return "CRITICAL"
	elseif threatPercent >= 0.65 then
		return "SEVERE"
	elseif threatPercent >= 0.4 then
		return "ELEVATED"
	end
	return "LOW"
end

local tierFallbackPercent = {
	LOW = 0.2,
	ELEVATED = 0.5,
	SEVERE = 0.72,
	CRITICAL = 0.9,
}

local rarityThreatFallback = {
	Common = 0.2,
	Uncommon = 0.35,
	Rare = 0.5,
	Epic = 0.7,
	Legendary = 0.88,
}

local function resolveThreatFields(data, rarity)
	if type(data) ~= "table" then
		return nil, nil
	end

	local rawPercent = data.ThreatPercent
	if type(rawPercent) ~= "number" then
		rawPercent = data.Threat
	end
	if type(rawPercent) ~= "number" then
		rawPercent = data.ThreatValue
	end
	if type(rawPercent) ~= "number" then
		rawPercent = data.ContractThreat
	end

	if type(rawPercent) == "number" and rawPercent > 1 then
		rawPercent = rawPercent / 100
	end

	local rawLabel = data.ThreatLabel
	if type(rawLabel) ~= "string" or rawLabel == "" then
		rawLabel = data.ThreatTier
	end
	if type(rawLabel) ~= "string" or rawLabel == "" then
		rawLabel = data.ThreatText
	end

	if type(rawPercent) ~= "number" and (type(rawLabel) ~= "string" or rawLabel == "") then
		rawPercent = rarityThreatFallback[rarity]
	end

	if type(rawPercent) ~= "number" and type(rawLabel) == "string" and rawLabel ~= "" then
		rawPercent = tierFallbackPercent[string.upper(rawLabel)] or 0.2
	end

	if type(rawPercent) ~= "number" then
		return nil, nil
	end

	local p = clampPercent(rawPercent)
	local tierText = type(rawLabel) == "string" and rawLabel ~= "" and string.upper(rawLabel) or threatTier(p)
	return p, tierText
end

local function setThreat(data, rarityColor, rarity)
	local p, tierText = resolveThreatFields(data, rarity)
	if type(p) ~= "number" then
		threatRow.Visible = false
		progressText.Position = UDim2.new(0, 14, 1, -22)
		return
	end

	threatRow.Visible = true
	progressText.Position = UDim2.new(0, 14, 1, -21)
	threatLabel.Text = "THREAT: " .. tierText

	local danger = blend(Color3.fromRGB(208, 70, 67), Color3.fromRGB(188, 126, 74), 1 - p)
	local dangerAccent = blend(danger, rarityColor, 0.12)
	threatLabel.TextColor3 = blend(dangerAccent, Color3.fromRGB(228, 205, 196), 0.15)
	threatFill.BackgroundColor3 = dangerAccent
	TweenService:Create(threatFill, TweenInfo.new(UIConfig.ThreatTweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(p, 0, 1, 0)
	}):Play()
end

local function pulseProgressBar()
	activePulseToken += 1
	local pulseToken = activePulseToken
	fillSheenGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.72),
		NumberSequenceKeypoint.new(0.45, 0.4),
		NumberSequenceKeypoint.new(1, 0.78),
	})
	local pulse = TweenService:Create(fillSheenGradient, TweenInfo.new(UIConfig.BarPulseTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Rotation = 8,
	})
	pulse:Play()
	pulse.Completed:Once(function()
		if pulseToken ~= activePulseToken then
			return
		end
		fillSheenGradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.92),
			NumberSequenceKeypoint.new(0.45, 0.72),
			NumberSequenceKeypoint.new(1, 0.94),
		})
	end)
end

local function setState(data)
	local rarity = data.Rarity or "Common"
	local rarityColor = getRarityColor(rarity)
	local fillStart, fillEnd = getFillColors(rarity)
	stroke.Color = blend(rarityColor, Color3.fromRGB(120, 95, 70), 0.45)
	glowStroke.Color = rarityColor
	fill.BackgroundColor3 = fillEnd
	fillGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, fillStart),
		ColorSequenceKeypoint.new(1, fillEnd),
	})

	title.Text = string.format("%s • %s", data.QuestName or "Night Quest", string.upper(rarity))

	local current = math.floor(tonumber(data.Current) or 0)
	local required = math.max(1, math.floor(tonumber(data.Required) or 1))
	local prefix = type(data.ProgressPrefix) == "string" and data.ProgressPrefix or ""
	if prefix ~= "" then
		progressText.Text = string.format("%s %d/%d", prefix, current, required)
	else
		progressText.Text = string.format("%d/%d", current, required)
	end

	local percent = clampPercent(data.Percent)
	TweenService:Create(fill, TweenInfo.new(UIConfig.FillTweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(percent, 0, 1, 0)
	}):Play()

	if percent > currentPercent + 0.001 then
		pulseProgressBar()
	end
	currentPercent = percent

	setThreat(data, rarityColor, rarity)
end

local function animateShow()
	currentlyVisible = true
	gui.Enabled = true
	root.Visible = true
	rootScale.Scale = 0.92
	root.BackgroundTransparency = 0.24
	stroke.Transparency = 0.74
	glowStroke.Transparency = 1
	TweenService:Create(rootScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	TweenService:Create(root, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.09}):Play()
	TweenService:Create(stroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.2}):Play()
	TweenService:Create(glowStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.74}):Play()
end

local function animateHide()
	if not currentlyVisible then
		gui.Enabled = false
		return
	end
	currentlyVisible = false
	local t1 = TweenService:Create(rootScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.95})
	local t2 = TweenService:Create(root, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 0.34})
	local t3 = TweenService:Create(stroke, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1})
	local t4 = TweenService:Create(glowStroke, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1})
	t1:Play(); t2:Play(); t3:Play(); t4:Play()
	t1.Completed:Once(function()
		if not currentlyVisible then
			gui.Enabled = false
		end
	end)
end

local function flashCompleted(rarity)
	completeTag.Visible = true
	completeTag.BackgroundColor3 = blend(getRarityColor(rarity), Color3.fromRGB(34, 90, 62), 0.45)
	if completedFlashThread then
		task.cancel(completedFlashThread)
	end
	completedFlashThread = task.spawn(function()
		local baseColor = stroke.Color
		for _ = 1, 2 do
			TweenService:Create(stroke, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = Color3.fromRGB(214, 201, 166)}):Play()
			TweenService:Create(glowStroke, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.52}):Play()
			task.wait(0.1)
			TweenService:Create(stroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Color = baseColor}):Play()
			TweenService:Create(glowStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 0.74}):Play()
			task.wait(0.12)
		end
		task.wait(1)
		completeTag.Visible = false
	end)
end

NightHUDUpdate.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then
		return
	end

	local eventType = data.Type
	if eventType == "Start" then
		setState(data)
		animateShow()
		playOneShot("rbxassetid://115916891254154")
	elseif eventType == "Progress" then
		if not gui.Enabled then
			animateShow()
		end
		setState(data)
	elseif eventType == "Complete" then
		if not gui.Enabled then
			animateShow()
		end
		setState(data)
		flashCompleted(data.Rarity)
	elseif eventType == "End" then
		playOneShot("rbxassetid://118805682366014")
		animateHide()
	end
end)
