									<Item class="LocalScript" referent="RBXB26B07831BDB40C28E61948F5D9EA4E3">
										<Properties>
											<ProtectedString name="Source"><![CDATA[-- Wait for settings system to load
local function waitForSettings()
	while not _G.getSetting do
		task.wait(0.1)
	end
end

-- Initialize slider state based on saved settings
local function initializeSlider()
	waitForSettings()
	local motionBlurEnabled = _G.getSetting("MotionBlurEnabled")
	
	if motionBlurEnabled then
		-- Set slider to ON position
		script.Parent.Parent.Parent.OnOrOff.Text = "On"
		script.Parent.Parent.SliderCircle.Position = UDim2.new(0.8, 0, 0.122, 0)
		thewhen = false
	else
		-- Set slider to OFF position
		script.Parent.Parent.Parent.OnOrOff.Text = "Off"
		script.Parent.Parent.SliderCircle.Position = UDim2.new(0.2, 0, 0.122, 0)
		thewhen = true
	end
end

local thewhen = false

-- Initialize slider when script starts
initializeSlider()

script.Parent.MouseButton1Click:Connect(function()
	waitForSettings()
	
	if thewhen == false then
		thewhen = true
		script.Parent.Parent.Parent.OnOrOff.Text = "Off"
		_G.MotionBlurEnabled = false
		_G.updateSetting("MotionBlurEnabled", false)
		-- Play OFF sound
		if _G.SettingsSoundManager then
			_G.SettingsSoundManager:playOff()
		end
		script.Parent.Parent.SliderCircle:TweenPosition(UDim2.new(0.5, 0,0.122, 0),"In","Linear",0.05,true)
		script.Parent.Parent.SliderCircle:TweenSize(UDim2.new(0.566, 0,0.737, 0),"In","Linear",0.05,true)
		task.wait(0.05)
		script.Parent.Parent.SliderCircle:TweenSize(UDim2.new(0.301, 0,0.737, 0),"In","Linear",0.05,true)
		script.Parent.Parent.SliderCircle:TweenPosition(UDim2.new(0.2, 0,0.122, 0),"In","Linear",0.05,true)
	else
		thewhen = false
		script.Parent.Parent.Parent.OnOrOff.Text = "On"
		_G.MotionBlurEnabled = true
		_G.updateSetting("MotionBlurEnabled", true)
		-- Play ON sound
		if _G.SettingsSoundManager then
			_G.SettingsSoundManager:playOn()
		end
		script.Parent.Parent.SliderCircle:TweenPosition(UDim2.new(0.5, 0,0.122, 0),"In","Linear",0.05,true)
		script.Parent.Parent.SliderCircle:TweenSize(UDim2.new(0.566, 0,0.737, 0),"In","Linear",0.05,true)
		task.wait(0.05)
		script.Parent.Parent.SliderCircle:TweenSize(UDim2.new(0.301, 0,0.737, 0),"In","Linear",0.05,true)
		script.Parent.Parent.SliderCircle:TweenPosition(UDim2.new(0.8, 0,0.122, 0),"In","Linear",0.05,true)
	end
end)]]></ProtectedString>
