	local lateWarningCorner = Instance.new("UICorner")
	lateWarningCorner.CornerRadius = UDim.new(0, 16)
	lateWarningCorner.Parent = lateWarningFrame

	local lateWarningStroke = Instance.new("UIStroke")
	lateWarningStroke.Color = Color3.fromRGB(235, 92, 92)
	lateWarningStroke.Thickness = 1.5
	lateWarningStroke.Transparency = 0.05
	lateWarningStroke.Parent = lateWarningFrame

	local lateWarningText = Instance.new("TextLabel")
	lateWarningText.Name = "Text"
	lateWarningText.BackgroundTransparency = 1
	lateWarningText.Size = UDim2.new(1, -24, 1, 0)
	lateWarningText.Position = UDim2.new(0, 12, 0, 0)
	lateWarningText.Font = Enum.Font.GothamBold
	lateWarningText.Text = "NO CREDIT: You joined after night started."
	lateWarningText.TextColor3 = Color3.fromRGB(255, 120, 120)
	lateWarningText.TextSize = 35
	lateWarningText.TextScaled = true
	lateWarningText.TextWrapped = true
	lateWarningText.TextXAlignment = Enum.TextXAlignment.Center
	lateWarningText.TextYAlignment = Enum.TextYAlignment.Center
	lateWarningText.ZIndex = 11
