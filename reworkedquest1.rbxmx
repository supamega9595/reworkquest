				<Item class="LocalScript" referent="RBX44240447D93840A1BB03CD1FA085FA77">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- Settings Manager - Handles saving and loading player settings
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- Default settings
local DEFAULT_SETTINGS = {
	GlobalShadows = true,
	EnvironmentSpecularScale = 1,
	EnvironmentDiffuseScale = 1,
	SoundRegionsMuted = false,
	FieldOfView = 100,
	CameraBobbingEnabled = true,
	MotionBlurEnabled = true,
	ChatEnabled = true
}

-- Current settings (will be loaded from storage)
local settings = {}

-- Function to save settings to player data store
local function saveSettings()
	local success, errorMessage = pcall(function()
		-- For now, use a simple approach with player's leaderstats or a folder
		-- In a real game, you'd use DataStoreService
		local settingsFolder = LocalPlayer:FindFirstChild("PlayerSettings")
		if not settingsFolder then
			settingsFolder = Instance.new("Folder")
			settingsFolder.Name = "PlayerSettings"
			settingsFolder.Parent = LocalPlayer
		end
		
		-- Clear existing settings
		for _, child in pairs(settingsFolder:GetChildren()) do
			child:Destroy()
		end
		
		-- Save each setting
		for settingName, value in pairs(settings) do
			local valueObj = Instance.new("StringValue")
			valueObj.Name = settingName
			valueObj.Value = tostring(value)
			valueObj.Parent = settingsFolder
		end
	end)
	
	if not success then
		warn("Failed to save settings: " .. tostring(errorMessage))
	end
end

-- Function to load settings from player data
local function loadSettings()
	-- Start with defaults
	for settingName, defaultValue in pairs(DEFAULT_SETTINGS) do
		settings[settingName] = defaultValue
	end
	
	-- Try to load saved settings
	local settingsFolder = LocalPlayer:FindFirstChild("PlayerSettings")
	if settingsFolder then
		for _, valueObj in pairs(settingsFolder:GetChildren()) do
			if DEFAULT_SETTINGS[valueObj.Name] ~= nil then
				local value = valueObj.Value
				-- Convert string back to appropriate type
				if value == "true" then
					settings[valueObj.Name] = true
				elseif value == "false" then
					settings[valueObj.Name] = false
				else
					local numValue = tonumber(value)
					if numValue then
						settings[valueObj.Name] = numValue
					else
						settings[valueObj.Name] = value
					end
				end
			end
		end
	end
end

-- Function to update a setting and save it
local function updateSetting(settingName, value)
	settings[settingName] = value
	saveSettings()
end
-- Function to get a setting value
local function getSetting(settingName)
	return settings[settingName]
end

-- Function to toggle chat system
local function toggleChat(enabled)
	local StarterGui = game:GetService("StarterGui")
	
	if enabled then
		-- Enable chat
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	else
		-- Disable chat
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
	end
end

-- Function to apply all settings on load
local function applyAllSettings()
	-- Apply lighting settings
	game.Lighting.GlobalShadows = settings.GlobalShadows
	game.Lighting.EnvironmentSpecularScale = settings.EnvironmentSpecularScale
	game.Lighting.EnvironmentDiffuseScale = settings.EnvironmentDiffuseScale
	
	-- Apply sound regions setting
	if settings.SoundRegionsMuted and _G.muteSoundRegions then
		_G.muteSoundRegions()
	elseif not settings.SoundRegionsMuted and _G.unmuteSoundRegions then
		_G.unmuteSoundRegions()
	end
	
	-- Apply FOV setting (wait for camera)
	local camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = settings.FieldOfView
	else
		workspace.CurrentCamera.Changed:Connect(function()
			if workspace.CurrentCamera.FieldOfView ~= settings.FieldOfView then
				workspace.CurrentCamera.FieldOfView = settings.FieldOfView
			end
		end)
	end
	
	-- Apply camera bobbing setting
	_G.CameraBobbingEnabled = settings.CameraBobbingEnabled
	
	-- Apply motion blur setting
	_G.MotionBlurEnabled = settings.MotionBlurEnabled
	
	-- Apply chat setting
	toggleChat(settings.ChatEnabled)
end

-- Make functions globally accessible
_G.updateSetting = updateSetting
_G.getSetting = getSetting
_G.applyAllSettings = applyAllSettings

-- Load settings when script starts
loadSettings()

-- Apply settings after a short delay to ensure everything is loaded
task.spawn(function()
	task.wait(1)
	applyAllSettings()
end)

-- Handle character respawn (reapply settings)
LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1) -- Wait for character to fully load
	applyAllSettings()
end)

-- Initialize settings GUI state (closed)
script.Parent.Position = UDim2.new(.5,0,1.5,0)
script.Parent.Visible = true]]></ProtectedString>
