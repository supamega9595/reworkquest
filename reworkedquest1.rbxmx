				<Item class="LocalScript" referent="RBX017765B19190461FBC7BADE6B4250425">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- Sound Manager for Settings GUI
local SoundManager = {}
SoundManager.__index = SoundManager

function SoundManager.new()
	local self = setmetatable({}, SoundManager)
	self.sounds = {
		on = Instance.new("Sound"),
		off = Instance.new("Sound"),
		open = Instance.new("Sound"),
		close = Instance.new("Sound")
	}
	
	-- Configure ON sound (you can change this ID)
	self.sounds.on.SoundId = "rbxassetid://87437544236708" -- Click sound
	self.sounds.on.Volume = 0.5
	self.sounds.on.Parent = script.Parent
	
	-- Configure OFF sound (you can change this ID)
	self.sounds.off.SoundId = "rbxassetid://87437544236708" -- Different click sound
	self.sounds.off.Volume = 0.5
	self.sounds.off.Parent = script.Parent
	
	-- Configure OPEN sound (you can change this ID)
	self.sounds.open.SoundId = "rbxassetid://3779053277" -- Menu open sound
	self.sounds.open.Volume = 0.3
	self.sounds.open.Parent = script.Parent
	
	-- Configure CLOSE sound (you can change this ID)
	self.sounds.close.SoundId = "rbxassetid://3779053277" -- Menu close sound
	self.sounds.close.Volume = 0.3
	self.sounds.close.Parent = script.Parent
	
	return self
end

function SoundManager:playOn()
	self.sounds.on:Play()
end

function SoundManager:playOff()
	self.sounds.off:Play()
end

function SoundManager:playOpen()
	self.sounds.open:Play()
end

function SoundManager:playClose()
	self.sounds.close:Play()
end

-- Create global sound manager instance
_G.SettingsSoundManager = SoundManager.new()

-- Export for other scripts
return SoundManager]]></ProtectedString>
