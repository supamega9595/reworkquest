				BurstDurationMin = 4,
				BurstDurationMax = 8,
				WaypointPauseSeconds = 3.0,
			},
			Uncommon = {
				RequiredSeconds = 240,
				DecayPercent = 0.50,
				ReverseChance = 0.10,
				BurstChance = 0.50,
				BurstDurationMin = 5,
				BurstDurationMax = 15,
				WaypointPauseSeconds = 2.5,
			},
			Rare = {
				RequiredSeconds = 280,
				DecayPercent = 0.65,
				ReverseChance = 0.14,
				BurstChance = 0.60,
				BurstDurationMin = 6,
				BurstDurationMax = 16,
				WaypointPauseSeconds = 2.0,
			},
			Epic = {
				RequiredSeconds = 330,
				DecayPercent = 0.80,
				ReverseChance = 0.18,
				BurstChance = 0.70,
				BurstDurationMin = 7,
				BurstDurationMax = 18,
				WaypointPauseSeconds = 1.5,
			},
			Legendary = {
				RequiredSeconds = 390,
				DecayPercent = 0.95,
				ReverseChance = 0.22,
				BurstChance = 0.80,
				BurstDurationMin = 8,
				BurstDurationMax = 20,
				WaypointPauseSeconds = 1.0,
			},
		},
	},

	SummaryUI = {
		AutoCloseSeconds = 10,
	},
}
]]></ProtectedString>
					<string name="ScriptGuid">{7c1fe18f-5c3e-4ff8-acde-9f2ca67b7a14}</string>
