	-- Base rewards
	SurvivalCashBase = 75,
	QuestCompleteCash = 250,
	DistanceCashPerStud = 0.35,

	XP = {
		SurvivalBase = 90,
		CompletionBonus = 160,
		DistancePerStud = 0.02,
	},

	-- Applies to survival + completion cash/xp only.
	MultipliersByRarity = {
		Common = 1.00,
		Uncommon = 1.25,
		Rare = 1.55,
		Epic = 2.00,
