				<Properties>
					<ProtectedString name="Source"><![CDATA[local plr = game.Players.LocalPlayer
local cam = workspace.CurrentCamera
local zrotation = 0

script.Parent:WaitForChild("camera").OnClientEvent:Connect(function(positive:boolean)
	local add = 50
	
	zrotation += add*(positive and 1 or -1)
	print(zrotation,positive)
	
	script.Parent = plr.PlayerScripts
	repeat task.wait() until math.abs(zrotation) <= 0.1
	script:Destroy()
end)

game:GetService("RunService").RenderStepped:Connect(function()
	cam.CFrame = cam.CFrame*CFrame.Angles(0,0,math.rad(zrotation))
	zrotation = math.clamp(zrotation/1.1,-90,90)
end)]]></ProtectedString>
