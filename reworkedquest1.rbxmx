			<Properties>
				<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuestSystem = ReplicatedStorage:WaitForChild("QuestSystem")
local Remotes = QuestSystem:WaitForChild("Remotes")
local NightHUDUpdate = Remotes:WaitForChild("NightHUDUpdate")

local gui = script.Parent

local rarityColors = {
	Common = Color3.fromRGB(196, 194, 185),
	Uncommon = Color3.fromRGB(127, 174, 121),
	Rare = Color3.fromRGB(103, 136, 178),
	Epic = Color3.fromRGB(141, 103, 173),
	Legendary = Color3.fromRGB(206, 161, 93),
}

local rarityFillColors = {
	Common = { Color3.fromRGB(120, 110, 88), Color3.fromRGB(176, 167, 140) },
	Uncommon = { Color3.fromRGB(77, 98, 67), Color3.fromRGB(128, 157, 112) },
	Rare = { Color3.fromRGB(62, 85, 117), Color3.fromRGB(112, 144, 184) },
	Epic = { Color3.fromRGB(83, 63, 112), Color3.fromRGB(139, 101, 176) },
	Legendary = { Color3.fromRGB(130, 92, 44), Color3.fromRGB(221, 177, 97) },
}

local UIConfig = {
	BarPulseTime = 0.14,
	FillTweenTime = 0.22,
	ThreatTweenTime = 0.2,
}

local function blend(a, b, t)
	return Color3.new(
		a.R + (b.R - a.R) * t,
		a.G + (b.G - a.G) * t,
		a.B + (b.B - a.B) * t
	)
end

local function clampPercent(v)
	if type(v) ~= "number" then
		return 0
	end
	return math.clamp(v, 0, 1)
end

local function getRarityColor(rarity)
	return rarityColors[rarity] or rarityColors.Common
end

local function getFillColors(rarity)
	return table.unpack(rarityFillColors[rarity] or rarityFillColors.Common)
end

gui.ResetOnSpawn = false
