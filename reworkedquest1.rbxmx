				<ProtectedString name="Source"><![CDATA[--[[

> TopbarPlus was developed by ForeverHD and is actively maintained
thanks to HD Admin.

> You can get in touch with me on Discord via the social link here:
https://create.roblox.com/store/asset/92368439343389/TopbarPlus

> READ_ME is Script with RunContext set to 'Client' meaning you can
store it in ReplicatedStorage and Workspace and it will still run
like a normal LocalScript. DO NOT PLACE place in StarterPlayerScripts
(because this is a Script with RunContext). You need to create a separate
LocalScript for anything under StarterPlayerScripts.

> You're welcome to move `Icon` and require it yourself. You can
then delete this folder and READ_ME.

> Icon is a Package for when Roblox (hopefully soon) release
public packages. This for example will enable you to receive
automatic updates, and to compare code easily between changes

> Have feedback? Post it to devforum.roblox.com/t/topbarplus/1017485
which I actively monitor. Enjoy! ~ForeverHD June 2025

--]]

local container = script.Parent
local Icon = require(container.Icon)

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local UserInputService = game:GetService("UserInputService")
local AvatarEditorService = game:GetService("AvatarEditorService")

--========================================================
-- SETTINGS GUI (unchanged logic)
--========================================================

-- Wait for settings GUI to be available
local settingsGui = nil
local function waitForSettingsGui()
	while not settingsGui do
		local settingsScreenGui = playerGui:FindFirstChild("Settings")
		if settingsScreenGui then
			local mainFrame = settingsScreenGui:FindFirstChild("MainFrame")
			if mainFrame then
				settingsGui = mainFrame:FindFirstChild("SettingsGui")
			end
		end
		if not settingsGui then
			task.wait(0.1)
		end
	end
end

-- Settings toggle state
local OPCL = false
local hasOpenedOnce = false
local wasMouseLocked = false

-- Function to toggle settings menu (copied from original OpenClose script)
local function toggleSettings()
	if not settingsGui then
		waitForSettingsGui()
	end

	if OPCL == false then
		OPCL = true
		settingsGui:TweenPosition(UDim2.new(0.5,0,0.5,0), "InOut", "Sine", .35, true)

		-- Play open sound
		if _G.SettingsSoundManager then
			_G.SettingsSoundManager:playOpen()
		end

		-- Unlock mouse for settings menu
		-- Store current mouse state
		wasMouseLocked = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)
		UserInputService.MouseIconEnabled = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default

		-- Notify Body View script that mouse should be free
		if _G.BodyViewMouseState then
			_G.BodyViewMouseState(true)
		end

		hasOpenedOnce = true
	else
		OPCL = false
		settingsGui:TweenPosition(UDim2.new(0.5,0,1.5,0), "InOut", "Sine", .35, true)

		-- Play close sound
		if _G.SettingsSoundManager then
			_G.SettingsSoundManager:playClose()
		end

		-- Only relock mouse if it was locked before and menu has been opened before
		if hasOpenedOnce and wasMouseLocked then
			UserInputService.MouseIconEnabled = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end

		-- Notify Body View script that mouse should be locked
		if _G.BodyViewMouseState then
			_G.BodyViewMouseState(false)
		end
	end
end

-- Create the settings icon
local icon = Icon.new()
	:setLabel("Settings")
	:setImage(6031280882, "Deselected")
	:setImage(187897041, "Selected")
	:bindEvent("selected", toggleSettings)
	:bindEvent("deselected", toggleSettings)

-- Ensure hotkey M still works
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.M then
		toggleSettings()
	end
end)

--========================================================
-- FAVORITE GAME ICON (unchanged)
--========================================================
local favoriteIcon = Icon.new()
	:setImage(1419897123, "Deselected") -- Heart icon
	:setImage(1419897123, "Selected") -- Filled heart icon
	:bindEvent("selected", function()
		AvatarEditorService:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
	end)

--========================================================
-- PLAYER CARD ICON (uses PlayerCardUi's TogglePlayerCard event)
--========================================================
local playerCardToggleEvent = nil
local retryingPlayerCard = false

local function getPlayerCardToggleEvent()
	local screen = playerGui:FindFirstChild("PlayerCard") or playerGui:WaitForChild("PlayerCard", 10)
	if not screen then
		warn("[TopBarEdit] PlayerCard ScreenGui not found in PlayerGui.")
		return nil
	end

	local ev = screen:FindFirstChild("TogglePlayerCard") or screen:WaitForChild("TogglePlayerCard", 10)
	if not ev or not ev:IsA("BindableEvent") then
		warn("[TopBarEdit] TogglePlayerCard BindableEvent not found (or not a BindableEvent).")
		return nil
	end

	return ev
end

local function firePlayerCard(open: boolean)
	if playerCardToggleEvent and playerCardToggleEvent.Parent then
		playerCardToggleEvent:Fire(open)
		return true
	end
	playerCardToggleEvent = getPlayerCardToggleEvent()
	if not playerCardToggleEvent then
		return false
	end
	playerCardToggleEvent:Fire(open)
	return true
end

local function setPlayerCardOpen(open: boolean)
	if firePlayerCard(open) then
		return
	end
	if retryingPlayerCard then
		return
	end
	retryingPlayerCard = true
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < 10 do
			if firePlayerCard(open) then
				retryingPlayerCard = false
				return
			end
			task.wait(0.25)
		end
		retryingPlayerCard = false
	end)
end

-- Create the PlayerCard icon
local playerCardIcon = Icon.new()
	:setLabel("Profile")
	:setImage(1249556329, "Deselected") -- User/profile icon
	:setImage(1249556329, "Selected")   -- Same icon for selected
	:bindEvent("selected", function()
		setPlayerCardOpen(true)
	end)
	:bindEvent("deselected", function()
		setPlayerCardOpen(false)
	end)
]]></ProtectedString>
