								<Item class="LocalScript" referent="RBX5560DD5919094DE08052F9BAD925C71B">
									<Properties>
										<ProtectedString name="Source"><![CDATA[-- FOV Slider Controller - Beautiful sliding bar implementation
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Get references to our GUI elements
local fovFrame = script.Parent.Parent
local sliderFrame = fovFrame.Slider
local progressBar = sliderFrame.ProgressBar
local sliderHandle = sliderFrame.SliderHandle
local valueDisplay = fovFrame.ValueDisplay
local inputButton = sliderFrame.InputButton

-- FOV range (70-120 as mentioned in the original placeholder)
local MIN_FOV = 70
local MAX_FOV = 120

-- State variables
local isDragging = false
local currentFOV = _G.getSetting and _G.getSetting("FieldOfView") or 100

-- Function to update slider position based on FOV value
local function updateSliderPosition(fovValue)
	-- Normalize FOV to 0-1 range
	local normalizedValue = (fovValue - MIN_FOV) / (MAX_FOV - MIN_FOV)
	normalizedValue = math.clamp(normalizedValue, 0, 1)
	
	-- Update progress bar width
	progressBar.Size = UDim2.new(normalizedValue, 0, 1, 0)
	
	-- Update handle position - FIXED ALIGNMENT
	-- Use relative positioning to avoid alignment issues
	local handleRelativeX = normalizedValue - (sliderHandle.AbsoluteSize.X / (2 * sliderFrame.AbsoluteSize.X))
	sliderHandle.Position = UDim2.new(handleRelativeX, 0, 0.5, -10)
	
	-- Update value display
	valueDisplay.Text = math.floor(fovValue) .. "°"
end

-- Function to update FOV based on slider position
local function updateFOVFromPosition(inputPosition)
	-- Calculate relative position within the slider frame
	local relativeX = inputPosition - sliderFrame.AbsolutePosition.X
	local normalizedValue = math.clamp(relativeX / sliderFrame.AbsoluteSize.X, 0, 1)
	local newFOV = MIN_FOV + (normalizedValue * (MAX_FOV - MIN_FOV))
	
	-- Update current FOV
	currentFOV = newFOV
	
	-- Update slider visuals
	updateSliderPosition(currentFOV)
	
	-- Apply FOV to camera
	local camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = currentFOV
	end
	
	-- Save setting
	if _G.updateSetting then
		_G.updateSetting("FieldOfView", currentFOV)
	end
end

-- Initialize slider with current FOV
updateSliderPosition(currentFOV)

-- Input handling
inputButton.MouseButton1Down:Connect(function()
	isDragging = true
	updateFOVFromPosition(UserInputService:GetMouseLocation().X)
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		updateFOVFromPosition(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDragging = false
	end
end)

-- Touch support for mobile
inputButton.TouchTap:Connect(function(touchPositions, state)
	if state == Enum.UserInputState.Begin then
		isDragging = true
		if #touchPositions > 0 then
			updateFOVFromPosition(touchPositions[1].X)
		end
	end
end)

UserInputService.TouchChanged:Connect(function(touch, processed)
	if isDragging and not processed then
		updateFOVFromPosition(touch.Position.X)
	end
end)

UserInputService.TouchEnded:Connect(function(touch, processed)
	if touch.UserInputType == Enum.UserInputType.Touch then
		isDragging = false
	end
end)

-- Add hover effects
local function addHoverEffect()
	local hoverTween = TweenService:Create(
		sliderHandle,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = UDim2.new(0, 24, 0, 24)}
	)
	hoverTween:Play()
end

local function removeHoverEffect()
	local normalTween = TweenService:Create(
		sliderHandle,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = UDim2.new(0, 20, 0, 20)}
	)
	normalTween:Play()
end

inputButton.MouseEnter:Connect(addHoverEffect)
inputButton.MouseLeave:Connect(removeHoverEffect)

-- Add a subtle pulse animation to the progress bar
local pulseTween = TweenService:Create(
	progressBar,
	TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
	{BackgroundColor3 = Color3.fromRGB(120, 220, 255)}
)
pulseTween:Play()]]></ProtectedString>
