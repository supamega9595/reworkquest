			<Item class="Script" referent="RBX6E66162398F144679748250244D2E736">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local deb = game:GetService("Debris")

function totemeffect()
	local char = script:FindFirstAncestorOfClass("Model")
	local plr = game.Players:GetPlayerFromCharacter(char)
	
	if not char then
		return
	end
	
	local root:Part = char:WaitForChild("HumanoidRootPart")
	local head:Part = char:WaitForChild("Head")
	local hum:Humanoid = char:WaitForChild("Humanoid")
	
	local h = Instance.new("Highlight")
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = char

	local iframes = 2
	local ff = Instance.new("ForceField")
	ff.Visible = false
	ff.Parent = char
	hum.Health = hum.MaxHealth*0.75
	
	local ss = Instance.new("Sound")
	ss.SoundId = "rbxassetid://6807298096"
	ss.Volume = 0.3
	ss.TimePosition = 0.32
	ss.PlaybackSpeed = Random.new():NextNumber(0.9,1.1)
	ss.Parent = root
	ss:Play()

	ss.Ended:Connect(function()
		ss:Destroy()
	end)

	local a,b = script.a:Clone(),script.b:Clone()
	a.Parent = root
	b.Parent = root
	a:Emit(60)
	b:Emit(20)
	
	if plr then
		script.Parent:WaitForChild("camera"):FireClient(plr,math.random(1,2)==1)
	end
	
	deb:AddItem(a,a.Lifetime.Max)
	deb:AddItem(b,b.Lifetime.Max)
	deb:AddItem(script.Parent,iframes)
	
	script.Parent.Parent = nil
	
	local dur = 0
	while dur < iframes do
		local col = Color3.fromHSV(Random.new():NextNumber(0,1),1,1)
		local trns = (dur-(iframes/2))/iframes
		h.FillColor = col
		h.OutlineColor = col
		h.FillTransparency = trns+0.6
		h.OutlineTransparency = trns+0.1
		dur += task.wait()
	end
	ff:Destroy()
	h:Destroy()
end

local equipped = false
script.Parent.Equipped:Connect(function()
	equipped = true
	
	local char = script:FindFirstAncestorOfClass("Model")
	local plr = game.Players:GetPlayerFromCharacter(char)

	if not char then
		return
	end

	local root = char:WaitForChild("HumanoidRootPart")
	local hum:Humanoid = char:WaitForChild("Humanoid")
	
	local humcon
	humcon = hum.Changed:Connect(function()
		if equipped then
			if hum.Health <= 0 then
				totemeffect()
			end
			
			hum.Health = math.clamp(hum.Health,0.01,hum.MaxHealth)
		else
			humcon:Disconnect()
		end
	end)
end)

script.Parent.Unequipped:Connect(function()
	equipped = false
end)]]></ProtectedString>
