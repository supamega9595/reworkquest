					<ProtectedString name="Source"><![CDATA[return {
	NPCName = "Showcase NPC",
	PromptActionText = "Talk",
	PromptObjectText = "Contract Board",
	BoardFlavor = "All contracts are binding until dawn.",
	DayLines = {
		Intro = {
			"Another morning, another debt to the dark. Need tonight's contract?",
			"I've got a fresh contract for the night. Interested?",
		},
		Responses = {
			"Show tonight's contract",
			"Not right now",
		},
		ContractResponseIndex = 1,
		ExitLine = "Come back before sundown.",
		AcceptLine = "Take it and survive the night.",
	},
	NightLines = {
		Intro = {
			"Night's fallen. No contracts now—just stay alive.",
			"Too late for paperwork. Keep breathing until dawn.",
		},
		Responses = {
			"Understood",
		},
		ExitLine = "Don't let the dark take you.",
	},
	RarityFlair = {
		Legendary = {
			"This one is marked in gold. Only the brave sign it.",
			"A legendary contract... the board itself trembled.",
		},
	},
}]]></ProtectedString>
