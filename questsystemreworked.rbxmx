					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuestSystem = ReplicatedStorage:WaitForChild("QuestSystem")
local Remotes = QuestSystem:WaitForChild("Remotes")
local NightHUDUpdate = Remotes:WaitForChild("NightHUDUpdate")

local gui = script.Parent
local colors = {
	Common = Color3.fromRGB(210, 210, 210),
	Uncommon = Color3.fromRGB(126, 214, 125),
	Rare = Color3.fromRGB(110, 165, 255),
	Epic = Color3.fromRGB(170, 110, 255),
	Legendary = Color3.fromRGB(255, 200, 110),
}

gui.ResetOnSpawn = false
gui.Enabled = false

local root = Instance.new("Frame")
root.Name = "Main"
root.AnchorPoint = Vector2.new(0.5, 0)
root.Position = UDim2.fromScale(0.5, 0.03)
root.Size = UDim2.fromScale(0.44, 0.12)
root.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
root.BackgroundTransparency = 0.08
root.BorderSizePixel = 0
root.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = root

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(120, 120, 120)
stroke.Thickness = 1.5
stroke.Transparency = 0.2
stroke.Parent = root

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MinSize = Vector2.new(320, 72)
sizeConstraint.MaxSize = Vector2.new(700, 130)
sizeConstraint.Parent = root

local title = Instance.new("TextLabel")
title.Name = "TitleLabel"
title.BackgroundTransparency = 1
title.Position = UDim2.new(0, 14, 0, 6)
title.Size = UDim2.new(1, -28, 0, 22)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.TextColor3 = Color3.fromRGB(235, 235, 235)
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "Night Quest"
title.Parent = root

local progressText = Instance.new("TextLabel")
progressText.Name = "ProgressText"
progressText.BackgroundTransparency = 1
progressText.Position = UDim2.new(0, 14, 1, -26)
progressText.Size = UDim2.new(1, -28, 0, 18)
progressText.Font = Enum.Font.GothamSemibold
progressText.TextSize = 14
progressText.TextColor3 = Color3.fromRGB(220, 220, 220)
progressText.TextXAlignment = Enum.TextXAlignment.Right
progressText.Text = "0/0"
progressText.Parent = root

local bar = Instance.new("Frame")
bar.Name = "ProgressBar"
bar.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
bar.BorderSizePixel = 0
bar.Position = UDim2.new(0, 14, 0, 34)
bar.Size = UDim2.new(1, -28, 0, 16)
bar.Parent = root

local barCorner = Instance.new("UICorner")
barCorner.CornerRadius = UDim.new(1, 0)
barCorner.Parent = bar

local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.BackgroundColor3 = colors.Common
fill.BorderSizePixel = 0
fill.Size = UDim2.new(0, 0, 1, 0)
fill.Parent = bar

local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(1, 0)
fillCorner.Parent = fill

local function playOneShot(soundId)
	local s = Instance.new("Sound")
	s.SoundId = soundId
	s.Volume = 0.8
	s.Parent = gui
	s:Play()
	s.Ended:Connect(function() s:Destroy() end)
end

local function setState(data)
	local rarity = data.Rarity or "Common"
	title.Text = string.format("%s • %s", data.QuestName or "Night Quest", string.upper(rarity))
	progressText.Text = string.format("%d/%d", math.floor(data.Current or 0), math.max(1, math.floor(data.Required or 1)))
	local percent = math.clamp(data.Percent or 0, 0, 1)
	TweenService:Create(fill, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(percent, 0, 1, 0)}):Play()
	fill.BackgroundColor3 = colors[rarity] or colors.Common
	stroke.Color = (colors[rarity] or colors.Common)
end

NightHUDUpdate.OnClientEvent:Connect(function(data)
	if type(data) ~= "table" then return end
	if data.Type == "Start" then
		gui.Enabled = true
		root.Visible = true
		setState(data)
		playOneShot("rbxassetid://115916891254154")
	elseif data.Type == "Progress" then
		if not gui.Enabled then gui.Enabled = true end
		setState(data)
	elseif data.Type == "End" then
		if gui.Enabled then
			playOneShot("rbxassetid://118805682366014")
		end
		gui.Enabled = false
	elseif data.Type == "Complete" then
		setState(data)
	end
end)
