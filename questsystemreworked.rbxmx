	</Item>
	<Item class="Script" referent="RBXA221B97D3EB54D728A7D67BDF2DDD6BE">
		<Properties>
			<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local QuestSystem = ReplicatedStorage:WaitForChild("QuestSystem")
local Config = QuestSystem:WaitForChild("Config")
local Remotes = QuestSystem:WaitForChild("Remotes")
local State = QuestSystem:WaitForChild("State")

local TimeConfig = require(Config.TimeConfig)
local RarityConfig = require(Config.RarityConfig)
local QuestContractsConfig = require(Config.QuestContractsConfig)
local DialogueConfig = require(Config.DialogueConfig)
local RewardsConfig = require(Config.RewardsConfig)
local QuestSettings = require(Config.QuestSettings)

local RequestContractUI = Remotes:WaitForChild("RequestContractUI")
local ShowContractUI = Remotes:WaitForChild("ShowContractUI")
local AcceptContract = Remotes:WaitForChild("AcceptContract")
local ShowNightSummary = Remotes:WaitForChild("ShowNightSummary")
local NightHUDUpdate = Remotes:FindFirstChild("NightHUDUpdate")
if not NightHUDUpdate then
	NightHUDUpdate = Instance.new("RemoteEvent")
	NightHUDUpdate.Name = "NightHUDUpdate"
	NightHUDUpdate.Parent = Remotes
end

local ActiveContractId = State:WaitForChild("ActiveContractId")
local DayIndex = State:WaitForChild("DayIndex")
local ActiveContractRarity = State:FindFirstChild("ActiveContractRarity")
if not ActiveContractRarity then
	ActiveContractRarity = Instance.new("StringValue")
	ActiveContractRarity.Name = "ActiveContractRarity"
	ActiveContractRarity.Value = "Common"
	ActiveContractRarity.Parent = State
end

local function isDaytime(minutes)
	return minutes >= TimeConfig.DayStartMinutes and minutes < TimeConfig.DayEndMinutes
end

local function getContractById(contractId)
	for _, contract in ipairs(QuestContractsConfig) do
		if contract.Id == contractId then
			return contract
		end
	end
	return nil
end

local questState

local function computeThreat(questType, rarity)
	local baseByQuest = {
		Pages = 20,
		CaptureQuest = 40,
	}
	local addByRarity = {
		Common = 0,
		Uncommon = 10,
		Rare = 20,
		Epic = 30,
		Legendary = 40,
	}
	return math.clamp((baseByQuest[questType] or 0) + (addByRarity[rarity] or 0), 0, 100)
end

local function rollQuestAssignment()
	local pool = {"Pages", "CaptureQuest"}
	local rarityPool = {"Common", "Uncommon", "Rare", "Epic", "Legendary"}
	print("[Quest] Pool:", table.concat(pool, ", "))
	local questType = pool[math.random(1, #pool)]
	local rarity = rarityPool[math.random(1, #rarityPool)]
	local questIdByType = {
		Pages = "daily_pages",
		CaptureQuest = "capture_ring",
	}
	local questId = questIdByType[questType]
	local contract = getContractById(questId)
	if not contract then
		warn("QuestService: rolled quest id missing from config:", questId)
		return nil
	end
	local threat = computeThreat(questType, rarity)
	questState.currentContract = {
		QuestId = questType,
		Rarity = rarity,
		Threat = threat,
		AssignedAt = os.time(),
	}
	ActiveContractId.Value = questId
	ActiveContractRarity.Value = rarity
	print(string.format("[QuestService] Assigned quest for night: %s rarity=%s threat=%d", questType, rarity, threat))
	return contract
end

questState = {
	activeContract = nil,
	progress = 0,
	target = 0,
	completed = false,
	connections = {},
	startTime = 0,
	playerDistances = {},
	playerLastPositions = {},
	playerDied = {},
	playerDeathConnections = {},
	activePages = {},
	nightEligibleUserIds = {},
	runtimeFolder = nil,
	runtimeQuestRoot = nil,
	captureState = nil,
	lateJoinerUserIds = {},
	currentContract = nil,
	hudState = { active = false, completed = false, questName = "", rarity = "Common", current = 0, required = 1, percent = 0 },
	nightDayIndex = 0,
}

local function clearQuestConnections()
	for _, connection in ipairs(questState.connections) do
		connection:Disconnect()
	end
	questState.connections = {}
end

local function clearCaptureState()
	local captureState = questState.captureState
	if not captureState then
		return
	end
	captureState.running = false
	for _, connection in ipairs(captureState.connections) do
		connection:Disconnect()
	end
	captureState.connections = {}
	for _, thread in ipairs(captureState.threads) do
		task.cancel(thread)
	end
	captureState.threads = {}
	if captureState.burstLoopSound then
		captureState.burstLoopSound:Stop()
		captureState.burstLoopSound:Destroy()
	end
	questState.captureState = nil
end

local function destroyRuntimeFolder()
	if questState.runtimeFolder and questState.runtimeFolder.Parent then
		questState.runtimeFolder:Destroy()
	end
	questState.runtimeFolder = nil
	questState.runtimeQuestRoot = nil
end

local function cleanupNightRuntime()
	clearCaptureState()
	destroyRuntimeFolder()
end

local function createRuntimeRoot(contract)
	destroyRuntimeFolder()
	local runtimeFolder = Instance.new("Folder")
	runtimeFolder.Name = "QuestRuntime"
	runtimeFolder.Parent = workspace
	questState.runtimeFolder = runtimeFolder

	local spawns = ReplicatedStorage:FindFirstChild("QuestSpawns")
	if not spawns then
		warn("QuestService: ReplicatedStorage.QuestSpawns missing.")
		return nil
	end

	local templateName
	if contract.Type == "CaptureQuest" then
		templateName = "CaptureQuest"
	else
		templateName = "Pages"
	end

	local templateRoot = spawns:FindFirstChild(templateName)
	if not templateRoot then
		warn("QuestService: Missing quest template root:", templateName)
		return nil
	end

	local runtimeRoot = templateRoot:Clone()
	runtimeRoot.Parent = runtimeFolder
	questState.runtimeQuestRoot = runtimeRoot
	return runtimeRoot
end

local function isPlayerAlive(player)
	local character = player.Character
	if not character then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.Health > 0 or false
end

local function isNightEligible(player)
	return questState.nightEligibleUserIds[player.UserId] == true
end

local function getAssignedRarity()
	return ActiveContractRarity.Value ~= "" and ActiveContractRarity.Value or "Common"
end

local function getPagesTargetForRarity(rarity)
	local counts = QuestSettings.Pages and QuestSettings.Pages.RequiredByRarity or nil
	if type(counts) ~= "table" then
		return 8
	end
	return counts[rarity] or counts.Common or 8
end

local function isNightParticipant(player)
	return isNightEligible(player) or questState.lateJoinerUserIds[player.UserId] == true
end

local function getPlayerJoinMeta(player)
	local joinedDayIndex = player:GetAttribute("QuestJoinDayIndex")
	local joinedDuringNight = player:GetAttribute("QuestJoinedDuringNight")
	if type(joinedDayIndex) ~= "number" then
		joinedDayIndex = DayIndex.Value
		player:SetAttribute("QuestJoinDayIndex", joinedDayIndex)
	end
	if type(joinedDuringNight) ~= "boolean" then
		joinedDuringNight = not isDaytime(Lighting:GetMinutesAfterMidnight())
		player:SetAttribute("QuestJoinedDuringNight", joinedDuringNight)
	end
	return joinedDayIndex, joinedDuringNight
end

local function joinedDuringActiveNight(player)
	local joinedDayIndex, joinedDuringNight = getPlayerJoinMeta(player)
	return joinedDuringNight and joinedDayIndex == questState.nightDayIndex
end

local function broadcastNightHUD(payload)
	for _, player in ipairs(Players:GetPlayers()) do
		NightHUDUpdate:FireClient(player, payload)
	end
end

local function setNightHUDProgress(current, required, completed)
	required = math.max(required or 1, 1)
	local clamped = math.clamp(current or 0, 0, required)
	questState.hudState.current = clamped
	questState.hudState.required = required
	questState.hudState.percent = clamped / required
	if completed ~= nil then
		questState.hudState.completed = completed
	end
	broadcastNightHUD({
		Type = "Progress",
		QuestId = questState.currentContract and questState.currentContract.QuestId or "",
		QuestName = questState.hudState.questName,
		Rarity = questState.hudState.rarity,
		Current = clamped,
		Required = required,
		Percent = questState.hudState.percent,
		Completed = questState.hudState.completed,
	})
end

local function showNightHUD(questName, rarity, current, required)
	questState.hudState.active = true
	questState.hudState.completed = false
	questState.hudState.questName = questName
	questState.hudState.rarity = rarity
	setNightHUDProgress(current, required, false)
	broadcastNightHUD({
		Type = "Start",
		QuestId = questState.currentContract and questState.currentContract.QuestId or "",
		QuestName = questName,
		Rarity = rarity,
		Current = questState.hudState.current,
		Required = questState.hudState.required,
		Percent = questState.hudState.percent,
		Completed = false,
	})
end

local function endNightHUD()
	if questState.hudState.active then
		broadcastNightHUD({Type = "End"})
	end
	questState.hudState = { active = false, completed = false, questName = "", rarity = "Common", current = 0, required = 1, percent = 0 }
end

local function getPlayerFromHit(hit)
	if not hit then
		return nil
	end
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	return Players:GetPlayerFromCharacter(character)
end

local function getPickupBasePart(instance)
	if instance:IsA("ProximityPrompt") then
		local parent = instance.Parent
		if parent and parent:IsA("BasePart") then
			return parent
		elseif parent and parent:IsA("Model") then
			return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
		end
	elseif instance:IsA("BasePart") then
		return instance
	elseif instance:IsA("Model") then
		return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function getQuestPagesFolder()
	local runtime = workspace:FindFirstChild("QuestRuntime")
	if not runtime then
		return nil
	end
	return runtime:FindFirstChild("Pages")
end

local function recordPartDefaults(part)
	if part:GetAttribute("QuestDefaultTransparency") == nil then
		part:SetAttribute("QuestDefaultTransparency", part.Transparency)
	end
	if part:GetAttribute("QuestDefaultCanCollide") == nil then
		part:SetAttribute("QuestDefaultCanCollide", part.CanCollide)
	end
	if part:GetAttribute("QuestDefaultCanTouch") == nil then
		part:SetAttribute("QuestDefaultCanTouch", part.CanTouch)
	end
	if part:GetAttribute("QuestDefaultCanQuery") == nil then
		part:SetAttribute("QuestDefaultCanQuery", part.CanQuery)
	end
end

local function recordSurfaceDefaults(surface)
	if surface:GetAttribute("QuestDefaultTransparency") == nil then
		surface:SetAttribute("QuestDefaultTransparency", surface.Transparency)
	end
end

local function setSurfaceVisibility(surface, isActive)
	recordSurfaceDefaults(surface)
	surface.Transparency = isActive and (surface:GetAttribute("QuestDefaultTransparency") or surface.Transparency) or 1
end

local function setPartVisibility(part, isActive)
	recordPartDefaults(part)
	if isActive then
		part.Transparency = part:GetAttribute("QuestDefaultTransparency") or part.Transparency
		part.CanCollide = part:GetAttribute("QuestDefaultCanCollide") ~= false
		part.CanTouch = part:GetAttribute("QuestDefaultCanTouch") ~= false
		part.CanQuery = part:GetAttribute("QuestDefaultCanQuery") ~= false
	else
		part.Transparency = 1
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
	end
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("Decal") or child:IsA("Texture") then
			setSurfaceVisibility(child, isActive)
		end
	end
end

local function setPromptVisibility(prompt, isActive)
	if prompt:GetAttribute("QuestDefaultEnabled") == nil then
		prompt:SetAttribute("QuestDefaultEnabled", prompt.Enabled)
	end
	prompt.Enabled = isActive and prompt:GetAttribute("QuestDefaultEnabled") ~= false
end

local function setPageActive(page, isActive)
	local parts = {}
	if page:IsA("BasePart") then
		table.insert(parts, page)
	else
		for _, descendant in ipairs(page:GetDescendants()) do
			if descendant:IsA("BasePart") then
				table.insert(parts, descendant)
			end
		end
	end
	for _, part in ipairs(parts) do
		setPartVisibility(part, isActive)
	end

	local prompts = {}
	if page:IsA("ProximityPrompt") then
		table.insert(prompts, page)
	else
		for _, descendant in ipairs(page:GetDescendants()) do
			if descendant:IsA("ProximityPrompt") then
				table.insert(prompts, descendant)
			end
		end
	end
	for _, prompt in ipairs(prompts) do
		setPromptVisibility(prompt, isActive)
	end
end

local function findPageRoot(instance)
	local folder = getQuestPagesFolder()
	if not folder then
		return nil
	end
	local node = instance
	while node and node ~= workspace do
		if node.Parent == folder then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function removeQuestPickupTags(page)
	if CollectionService:HasTag(page, QuestSettings.Pages.PickupTag) then
		CollectionService:RemoveTag(page, QuestSettings.Pages.PickupTag)
	end
	for _, descendant in ipairs(page:GetDescendants()) do
		if CollectionService:HasTag(descendant, QuestSettings.Pages.PickupTag) then
			CollectionService:RemoveTag(descendant, QuestSettings.Pages.PickupTag)
		end
	end
end

local function applyQuestPickupTag(page)
	local prompt = page:FindFirstChildOfClass("ProximityPrompt") or page:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		CollectionService:AddTag(prompt, QuestSettings.Pages.PickupTag)
		return
	end
	CollectionService:AddTag(page, QuestSettings.Pages.PickupTag)
end

local function resetAllPages()
	local folder = getQuestPagesFolder()
	if not folder then
		return
	end
	for _, page in ipairs(folder:GetChildren()) do
		if page:IsA("BasePart") or page:IsA("Model") then
			removeQuestPickupTags(page)
			setPageActive(page, false)
		end
	end
	questState.activePages = {}
end

local function selectRandomPages()
	local folder = getQuestPagesFolder()
	if not folder then
		return {}
	end
	local pages = {}
	for _, page in ipairs(folder:GetChildren()) do
		if page:IsA("BasePart") or page:IsA("Model") then
			table.insert(pages, page)
		end
	end
	for i = #pages, 2, -1 do
		local j = math.random(1, i)
		pages[i], pages[j] = pages[j], pages[i]
	end
	local count = math.min(QuestSettings.Pages.PagesToSpawn or 8, #pages)
	local selection = {}
	for i = 1, count do
		table.insert(selection, pages[i])
	end
	return selection
end

local function activatePageQuest()
	resetAllPages()
	if isDaytime(Lighting:GetMinutesAfterMidnight()) then
		return
	end
	local selection = selectRandomPages()
	for _, page in ipairs(selection) do
		setPageActive(page, true)
		applyQuestPickupTag(page)
	end
	questState.activePages = selection
end

local function deactivatePageQuest()
	resetAllPages()
end

local function hideCollectedPage(instance)
	local page = findPageRoot(instance) or instance
	if not page then
		return
	end
	local part = page:IsA("BasePart") and page or page:FindFirstChildWhichIsA("BasePart")
	if part then
		local sound = Instance.new("Sound")
		sound.SoundId = "rbxassetid://131858956380043"
		sound.Volume = 1
		sound.RollOffMode = Enum.RollOffMode.Inverse
		sound.RollOffMinDistance = 6
		sound.RollOffMaxDistance = 35
		sound.Parent = part
		sound:Play()
		sound.Ended:Connect(function() sound:Destroy() end)
	end
	setPageActive(page, false)
	removeQuestPickupTags(page)
end

local function registerDeathTracking(player)
	local function onCharacterAdded(character)
		local existing = questState.playerDeathConnections[player]
		if existing then
			existing:Disconnect()
			questState.playerDeathConnections[player] = nil
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
		if humanoid then
			local connection = humanoid.Died:Connect(function()
				questState.playerDied[player] = true
			end)
			questState.playerDeathConnections[player] = connection
		end
	end
	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		onCharacterAdded(player.Character)
	end
end

local function ensureNpcPrompt(isDay)
	local npc = workspace:FindFirstChild("showcase npc")
	if not npc then return end
	local templateFolder = workspace:FindFirstChild("Custom Prompts")
	local promptTemplate = templateFolder and templateFolder:FindFirstChild("Prompt1")
	local templatePrompt = promptTemplate and promptTemplate:FindFirstChildOfClass("ProximityPrompt")
	if not templatePrompt then return end

	local existingPrompt = npc:FindFirstChildOfClass("ProximityPrompt")
	if existingPrompt then existingPrompt:Destroy() end

	local clonedPrompt = templatePrompt:Clone()
	clonedPrompt.Name = "ProximityPrompt"
	clonedPrompt.ActionText = DialogueConfig.PromptActionText
	clonedPrompt.ObjectText = DialogueConfig.PromptObjectText
	clonedPrompt.Parent = npc
	CollectionService:AddTag(clonedPrompt, "NPCprompt")

	local conf = clonedPrompt:FindFirstChild("CustomPromptConf")
	local custom = conf and conf:FindFirstChild("CustomPrompt")
	local nameValue = custom and custom:FindFirstChild("PromptName")
	if nameValue and nameValue:IsA("StringValue") then
		nameValue.Value = isDay and "Prompt1" or "Prompt2"
	end
end

local function updatePromptStyle(isDay)
	local npc = workspace:FindFirstChild("showcase npc")
	local prompt = npc and npc:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end
	local conf = prompt:FindFirstChild("CustomPromptConf")
	local custom = conf and conf:FindFirstChild("CustomPrompt")
	local nameValue = custom and custom:FindFirstChild("PromptName")
	if nameValue and nameValue:IsA("StringValue") then
		nameValue.Value = isDay and "Prompt1" or "Prompt2"
	end
end

local function play3DSound(soundId, parentPart, maxDistance)
	if not parentPart or not parentPart.Parent then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.RollOffMode = Enum.RollOffMode.Inverse
	sound.RollOffMinDistance = 10
	sound.RollOffMaxDistance = maxDistance or 2000
	sound.Volume = 1
	sound.Parent = parentPart
	sound:Play()
	sound.Ended:Connect(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	return sound
end

local questHandlers = {}

questHandlers.SharedCollectCount = {
	start = function(contract)
		questState.target = getPagesTargetForRarity(getAssignedRarity())
		questState.progress = 0
		questState.completed = false
		local pickupTag = contract.Settings.PickupTag
		local collected = {}

		local function registerPickup(instance)
			if collected[instance] then return end
			collected[instance] = true
			if pickupTag == QuestSettings.Pages.PickupTag then
				hideCollectedPage(instance)
			end
			questState.progress += 1
			setNightHUDProgress(questState.progress, questState.target, false)
			if questState.progress >= questState.target then
				questState.completed = true
				setNightHUDProgress(questState.target, questState.target, true)
			end
		end

		local function connectInstance(instance)
			local part = getPickupBasePart(instance)
			if not part then return end
			if instance:IsA("ProximityPrompt") then
				table.insert(questState.connections, instance.Triggered:Connect(function() registerPickup(instance) end))
			else
				table.insert(questState.connections, part.Touched:Connect(function(hit)
					if getPlayerFromHit(hit) then
						registerPickup(instance)
					end
				end))
			end
		end

		for _, instance in ipairs(CollectionService:GetTagged(pickupTag)) do
			connectInstance(instance)
		end
		table.insert(questState.connections, CollectionService:GetInstanceAddedSignal(pickupTag):Connect(connectInstance))
	end,
	stop = function()
		clearQuestConnections()
	end,
}





questHandlers.CaptureQuest = {
	start = function(contract)
		local captureRoot = questState.runtimeQuestRoot
		if not captureRoot or captureRoot.Name ~= "CaptureQuest" then
			warn("QuestService: runtime CaptureQuest root missing.")
			return
		end

		print("[QuestService] runtimeCapture path: Workspace.QuestRuntime.CaptureQuest")
		local capCircle = captureRoot:FindFirstChild("CapCircle")
		print("[QuestService] CapCircle exists:", capCircle ~= nil)
		local basePart = capCircle and capCircle:FindFirstChild("Base")
		print("[QuestService] Base exists:", basePart ~= nil)
		local radiusPart = capCircle and capCircle:FindFirstChild("Circle3")
		print("[QuestService] Circle3 exists:", radiusPart ~= nil)
		if not (capCircle and capCircle:IsA("Model") and basePart and basePart:IsA("BasePart") and radiusPart and radiusPart:IsA("BasePart")) then
			warn("QuestService: Capture quest runtime validation failed.")
			return
		end

		local waypoints = {}
		for _, child in ipairs(captureRoot:GetChildren()) do
			if child:IsA("BasePart") then
				local idx = tonumber(string.match(child.Name, "^Part(%d+)$"))
				if idx then
					table.insert(waypoints, {index = idx, part = child})
				end
			end
		end
		table.sort(waypoints, function(a, b) return a.index < b.index end)
		local names = {}
		for i = 1, math.min(5, #waypoints) do
			table.insert(names, waypoints[i].part.Name)
		end
		print("[QuestService] Capture waypoints:", #waypoints, table.concat(names, ", "))
		if #waypoints == 0 then
			warn("[QuestService] CaptureQuest has ZERO waypoints; aborting capture logic.")
			return
		end

		for _, waypoint in ipairs(waypoints) do
			waypoint.part.Anchored = true
			waypoint.part.CanCollide = false
		end

		local settings = contract.Settings or {}
		local rarity = contract.Rarity or getAssignedRarity()
		local captureByRarity = (((QuestSettings or {}).CaptureQuest or {}).ByRarity) or {}
		local raritySettings = captureByRarity[rarity] or captureByRarity.Uncommon or {
			RequiredSeconds = 240,
			DecayPercent = 0.50,
			ReverseChance = 0.10,
			BurstChance = 0.50,
			BurstDurationMin = 5,
			BurstDurationMax = 15,
			WaypointPauseSeconds = 2.5,
		}
		local baseSpeed = settings.BaseSpeed or 14
		local burstMultiplier = settings.BurstMultiplier or 2
		local accelerationTime = settings.AccelTime or 1.25
		local decelerationTime = settings.DecelTime or 1.25
		local waypointPauseSeconds = raritySettings.WaypointPauseSeconds
		local reverseChance = raritySettings.ReverseChance
		local burstCheckInterval = settings.BurstCheckInterval or 20
		local burstChance = raritySettings.BurstChance
		local burstDurationMin = raritySettings.BurstDurationMin
		local burstDurationMax = raritySettings.BurstDurationMax
		local gainRate = settings.GainRate or 1
		local decayPercent = raritySettings.DecayPercent
		local progressTick = settings.ProgressTickInterval or 0.25
		local required = raritySettings.RequiredSeconds
		local rotationBaseDeg = settings.BaseRotationDegPerSecond or 20
		print(string.format("[CaptureQuest] Rarity=%s Required=%d Decay=%.2f Reverse=%.2f Burst=%.2f Pause=%.1f", rarity, required, decayPercent, reverseChance, burstChance, waypointPauseSeconds))

		questState.target = required
		questState.progress = 0
		questState.completed = false

		local radius = ((radiusPart.Size.X * 0.5) + (radiusPart.Size.Z * 0.5)) * 0.5
		local state = {
			running = true,
			connections = {},
			threads = {},
			basePart = basePart,
			captureRoot = captureRoot,
			burstLoopSound = nil,
			burstActive = false,
			targetSpeed = baseSpeed,
			currentSpeed = baseSpeed,
			pauseUntil = 0,
			rotationYaw = 0,
			direction = 1,
		}
		questState.captureState = state

		local n = #waypoints
		local currentIndex = math.random(1, n)
		local function wrappedIndex(idx)
			if idx < 1 then return n end
			if idx > n then return 1 end
			return idx
		end
		local targetIndex = wrappedIndex(currentIndex + state.direction)
		local currentPosition = waypoints[currentIndex].part.Position
		capCircle:PivotTo(CFrame.new(currentPosition))
		print(string.format("[QuestService] Capture start waypoint index: %d total: %d", currentIndex, n))

		local function smoothingAlpha(dt)
			local target = state.targetSpeed
			local isAccelerating = target > state.currentSpeed
			local t = isAccelerating and accelerationTime or decelerationTime
			if t <= 0 then return 1 end
			return math.clamp(dt / t, 0, 1)
		end

		local function inTransition()
			return math.abs(state.currentSpeed - state.targetSpeed) > 0.2
		end

		local burstThread = task.spawn(function()
			while state.running do
				task.wait(burstCheckInterval)
				if not state.running then break end
				if math.random() <= burstChance then
					local duration = burstDurationMin + math.random() * (burstDurationMax - burstDurationMin)
					print(string.format("Burst triggered: duration %.2f", duration))
					play3DSound("rbxassetid://122534507946416", basePart, 200)
					state.burstActive = true
					state.targetSpeed = baseSpeed * burstMultiplier
					task.wait(duration)
					if state.running then
						state.burstActive = false
						state.targetSpeed = baseSpeed
					end
				end
			end
		end)
		table.insert(state.threads, burstThread)

		local progressThread = task.spawn(function()
			while state.running do
				task.wait(progressTick)
				if not state.running then break end
				local inside = false
				for _, player in ipairs(Players:GetPlayers()) do
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if root and (root.Position - basePart.Position).Magnitude <= radius then
						inside = true
						break
					end
				end
				local delta = gainRate * progressTick
				if inside then
					questState.progress = math.clamp(questState.progress + delta, 0, required)
				else
					questState.progress = math.clamp(questState.progress - (delta * decayPercent), 0, required)
				end
				setNightHUDProgress(math.floor(questState.progress), required, false)
				if questState.progress >= required and not questState.completed then
					questState.completed = true
					print("Capture quest completed")
					if state.burstLoopSound then state.burstLoopSound:Stop() end
					play3DSound("rbxassetid://135134898038127", basePart, 2000)
					state.running = false
					setNightHUDProgress(required, required, true)
					if captureRoot.Parent then
						captureRoot:Destroy()
					end
				end
			end
		end)
		table.insert(state.threads, progressThread)

		local moveConnection = RunService.Heartbeat:Connect(function(dt)
			if not state.running then return end
			state.currentSpeed += (state.targetSpeed - state.currentSpeed) * smoothingAlpha(dt)
			local rotationSpeed = rotationBaseDeg * (state.currentSpeed / baseSpeed)
			state.rotationYaw += math.rad(rotationSpeed * dt)

			local now = os.clock()
			if now < state.pauseUntil then
				capCircle:PivotTo(CFrame.new(currentPosition) * CFrame.Angles(0, state.rotationYaw, 0))
				return
			end

			local targetPos = waypoints[targetIndex].part.Position
			local offset = targetPos - currentPosition
			local distance = offset.Magnitude
			local step = state.currentSpeed * dt
			if distance <= step or distance <= 0.001 then
				currentPosition = targetPos
				local reverseTriggered = math.random() < reverseChance
				if reverseTriggered then
					print("Reverse triggered")
					play3DSound("rbxassetid://134113957270216", basePart, 200)
					state.direction *= -1
				end
				currentIndex = targetIndex
				targetIndex = wrappedIndex(currentIndex + state.direction)

				local stableAtBase = not state.burstActive and not inTransition() and math.abs(state.currentSpeed - baseSpeed) < 0.2
				if stableAtBase then
					state.pauseUntil = now + waypointPauseSeconds
				end
			else
				currentPosition += offset.Unit * step
			end
			capCircle:PivotTo(CFrame.new(currentPosition) * CFrame.Angles(0, state.rotationYaw, 0))
		end)
		table.insert(state.connections, moveConnection)
	end,
	stop = function(nightEnded)
		local captureState = questState.captureState
		if nightEnded and captureState and not questState.completed then
			print("Capture quest failed")
			play3DSound("rbxassetid://140251382260617", captureState.basePart, 2000)
		end
		clearCaptureState()
	end,
}

local function startNightlyQuest(contract)
	clearQuestConnections()
	cleanupNightRuntime()
	local currentContract = questState.currentContract
	if currentContract then
		contract.Rarity = currentContract.Rarity
		contract.Threat = currentContract.Threat
	else
		contract.Rarity = getAssignedRarity()
	end
	questState.activeContract = contract
	questState.startTime = os.time()
	questState.playerDistances = {}
	questState.playerLastPositions = {}
	questState.nightEligibleUserIds = {}
	questState.lateJoinerUserIds = {}
	questState.nightDayIndex = DayIndex.Value
	for _, player in ipairs(Players:GetPlayers()) do
		questState.playerDied[player] = false
		getPlayerJoinMeta(player)
		questState.nightEligibleUserIds[player.UserId] = true
	end
	local sampleEligible = {}
	for userId in pairs(questState.nightEligibleUserIds) do
		table.insert(sampleEligible, tostring(userId))
	end
	table.sort(sampleEligible)
	local preview = table.concat(sampleEligible, ", ", 1, math.min(6, #sampleEligible))
	print(string.format("[QuestService] Night eligible count=%d sample={%s}", #sampleEligible, preview))

	createRuntimeRoot(contract)

	local handler = questHandlers[contract.Type]
	if handler and handler.start then
		handler.start(contract)
	else
		warn("QuestService: No handler for quest type:", contract.Type)
	end

	if contract.Type == "SharedCollectCount" then
		activatePageQuest()
	end
	showNightHUD(contract.Name, contract.Rarity, questState.progress, questState.target > 0 and questState.target or 1)
end

local function stopNightlyQuest(nightEnded)
	local contract = questState.activeContract
	if contract then
		local handler = questHandlers[contract.Type]
		if handler and handler.stop then
			handler.stop(nightEnded)
		end
	end
	deactivatePageQuest()
	cleanupNightRuntime()
	questState.activeContract = nil
	questState.completed = false
	questState.progress = 0
	questState.target = 0
	questState.nightEligibleUserIds = {}
	questState.lateJoinerUserIds = {}
	endNightHUD()
end

local function calculateDistanceCash(distance)
	local cfg = RewardsConfig.Distance
	local softCap = cfg.SoftCapDistance
	if distance <= softCap then
		return distance * RewardsConfig.DistanceCashPerStud
	end
	local capped = softCap * RewardsConfig.DistanceCashPerStud
	local remaining = distance - softCap
	return capped + (remaining * RewardsConfig.DistanceCashPerStud * cfg.PostCapMultiplier)
end

local function calculateXP(distance, survivalAwarded, completionAwarded)
	local xpConfig = RewardsConfig.XP or {}
	local total = 0
	if survivalAwarded then
		total += xpConfig.SurvivalBase or 0
	end
	if completionAwarded then
		total += xpConfig.CompletionBonus or 0
	end
	total += distance * (xpConfig.DistancePerStud or 0)
	return math.floor(total)
end

local function awardCash(player, amount)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local cash = leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Coins")
		if cash and (cash:IsA("NumberValue") or cash:IsA("IntValue")) then
			cash.Value += math.floor(amount)
			return
		end
	end
	player:SetAttribute("DailyContractCash", math.floor((player:GetAttribute("DailyContractCash") or 0) + amount))
end

local function awardWins(player, amount)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local wins = leaderstats:FindFirstChild("Wins")
		if wins and wins:IsA("IntValue") then
			wins.Value += amount
			return
		end
	end
	player:SetAttribute("DailyContractWins", math.floor((player:GetAttribute("DailyContractWins") or 0) + amount))
end

local function awardXP(player, amount)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local xp = leaderstats:FindFirstChild("XP")
		if xp and (xp:IsA("IntValue") or xp:IsA("NumberValue")) then
			xp.Value += math.floor(amount)
			return
		end
	end
	player:SetAttribute("DailyContractXP", math.floor((player:GetAttribute("DailyContractXP") or 0) + amount))
end

local function payoutNightRewards()
	local contract = questState.activeContract
	if not contract then return end
	local rarityMultiplier = RewardsConfig.MultipliersByRarity[contract.Rarity] or 1

	for _, player in ipairs(Players:GetPlayers()) do
		local eligible = isNightEligible(player)
		local late = questState.lateJoinerUserIds[player.UserId] == true
		local joinedMidNight = joinedDuringActiveNight(player)
		local joinedLate = late or joinedMidNight or ((player:GetAttribute("QuestJoinedDuringNight") == true) and not eligible)
		local alive = isPlayerAlive(player)
		local distanceEligible = eligible or late or joinedMidNight
		local distance = distanceEligible and (questState.playerDistances[player] or 0) or 0
		local questCreditEligible = eligible and (not late) and (not joinedMidNight)
		local completionAwarded = questCreditEligible and questState.completed
		local survivalAwarded = questCreditEligible and alive
		local baseSurvivalCash = survivalAwarded and RewardsConfig.SurvivalCashBase or 0
		local baseCompletionCash = completionAwarded and RewardsConfig.QuestCompleteCash or 0
		local distanceCash = eligible and calculateDistanceCash(distance) or 0
		local totalCash = ((baseSurvivalCash + baseCompletionCash) * rarityMultiplier) + distanceCash

		local xpConfig = RewardsConfig.XP or {}
		local baseSurvivalXP = survivalAwarded and (xpConfig.SurvivalBase or 0) or 0
		local baseCompletionXP = completionAwarded and (xpConfig.CompletionBonus or 0) or 0
		local distanceXP = distanceEligible and (distance * (xpConfig.DistancePerStud or 0)) or 0
		local xpAward = math.floor(((baseSurvivalXP + baseCompletionXP) * rarityMultiplier) + distanceXP)
		local winsAward = survivalAwarded and 1 or 0
		print(string.format("[QuestService] Dawn player=%s eligible=%s late=%s joinedMidNight=%s alive=%s survived=%s questCredit=%s wins=%d", player.Name, tostring(eligible), tostring(late), tostring(joinedMidNight), tostring(alive), tostring(survivalAwarded), tostring(completionAwarded), winsAward))

		if totalCash > 0 then awardCash(player, totalCash) end
		if winsAward > 0 then awardWins(player, 1) end
		if xpAward > 0 then awardXP(player, xpAward) end

		ShowNightSummary:FireClient(player, {
			Survived = survivalAwarded,
			QuestCompleted = completionAwarded,
			Distance = distance,
			CashAwarded = totalCash,
			XPAwarded = xpAward,
			WinsAwarded = winsAward,
			JoinedLate = joinedLate,
		})
	end
end

local function updateDistanceTracking()
	local cfg = RewardsConfig.Distance
	for _, player in ipairs(Players:GetPlayers()) do
		if isNightParticipant(player) then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local last = questState.playerLastPositions[player]
				if last then
					local distance = (root.Position - last).Magnitude
					if distance >= cfg.MinSpeedToCount then
						questState.playerDistances[player] = (questState.playerDistances[player] or 0) + distance
					end
				end
				questState.playerLastPositions[player] = root.Position
			end
		end
	end
end

local function getResolvedContractData(player)
	local contract = getContractById(ActiveContractId.Value)
	if not contract then return nil end
	local assignedRarity = getAssignedRarity()
	local rarityData = RarityConfig.Rarities[assignedRarity] or RarityConfig.Rarities.Common
	local threat = (questState.currentContract and questState.currentContract.Threat) or contract.Threat or (rarityData and rarityData.DefaultThreat) or 0
	local accepted = player:GetAttribute("AcceptedContractId") == contract.Id and player:GetAttribute("AcceptedContractDay") == DayIndex.Value
	return {
		Id = contract.Id,
		Name = contract.Name,
		Description = contract.Description,
		Objectives = contract.Objectives,
		Rarity = assignedRarity,
		Threat = threat,
		DayIndex = DayIndex.Value,
		Accepted = accepted,
		Rewards = {
			Survival = RewardsConfig.SurvivalCashBase,
			Completion = RewardsConfig.QuestCompleteCash,
			Distance = RewardsConfig.DistanceCashPerStud,
		},
		FlavorLine = DialogueConfig.BoardFlavor,
	}
end

RequestContractUI.OnServerEvent:Connect(function(player)
	if not isDaytime(Lighting:GetMinutesAfterMidnight()) then return end
	local data = getResolvedContractData(player)
	if data then ShowContractUI:FireClient(player, data) end
end)

AcceptContract.OnServerEvent:Connect(function(player, contractId)
	if contractId ~= ActiveContractId.Value then return end
	if not isDaytime(Lighting:GetMinutesAfterMidnight()) then return end
	player:SetAttribute("AcceptedContractId", contractId)
	player:SetAttribute("AcceptedContractDay", DayIndex.Value)
end)

local function rollNewContract()
	rollQuestAssignment()
end

local lastIsDayRef = { value = isDaytime(Lighting:GetMinutesAfterMidnight()) }
if lastIsDayRef.value then
	DayIndex.Value = math.max(DayIndex.Value, 1)
	if ActiveContractId.Value == "" then
		rollNewContract()
	elseif ActiveContractRarity.Value == "" then
		ActiveContractRarity.Value = "Common"
	end
end

ensureNpcPrompt(lastIsDayRef.value)
for _, player in ipairs(Players:GetPlayers()) do
	if player:GetAttribute("QuestJoinDayIndex") == nil then
		player:SetAttribute("QuestJoinDayIndex", DayIndex.Value)
	end
	if player:GetAttribute("QuestJoinedDuringNight") == nil then
		player:SetAttribute("QuestJoinedDuringNight", not isDaytime(Lighting:GetMinutesAfterMidnight()))
	end
	registerDeathTracking(player)
end
if not lastIsDayRef.value then
	if not questState.currentContract then
		rollQuestAssignment()
	end
	local contract = getContractById(ActiveContractId.Value)
	if contract then startNightlyQuest(contract) end
end

task.spawn(function()
	while true do
		local isDay = isDaytime(Lighting:GetMinutesAfterMidnight())
		if isDay ~= lastIsDayRef.value then
			if isDay then
				DayIndex.Value += 1
				rollNewContract()
				updatePromptStyle(true)
				payoutNightRewards()
				stopNightlyQuest(true)
			else
				local contract = getContractById(ActiveContractId.Value)
				if contract then startNightlyQuest(contract) end
				updatePromptStyle(false)
			end
			lastIsDayRef.value = isDay
		end
		if not isDay and questState.activeContract then
			updateDistanceTracking()
		end
		task.wait(1)
	end
end)

Players.PlayerAdded:Connect(function(player)
	questState.playerDistances[player] = 0
	questState.playerLastPositions[player] = nil
	questState.playerDied[player] = false
	player:SetAttribute("QuestJoinDayIndex", DayIndex.Value)
	player:SetAttribute("QuestJoinedDuringNight", not isDaytime(Lighting:GetMinutesAfterMidnight()))
	registerDeathTracking(player)
	if not isDaytime(Lighting:GetMinutesAfterMidnight()) then
		questState.lateJoinerUserIds[player.UserId] = true
		print("[Quest] Late joiner no-credit (except distance): " .. player.Name)
		if questState.hudState.active then
			NightHUDUpdate:FireClient(player, {
				Type = "Start",
				QuestId = questState.currentContract and questState.currentContract.QuestId or "",
				QuestName = questState.hudState.questName,
				Rarity = questState.hudState.rarity,
				Current = questState.hudState.current,
				Required = questState.hudState.required,
				Percent = questState.hudState.percent,
				Completed = questState.hudState.completed,
			})
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	questState.playerDistances[player] = nil
	questState.playerLastPositions[player] = nil
	questState.playerDied[player] = nil
	local connection = questState.playerDeathConnections[player]
	if connection then
		connection:Disconnect()
		questState.playerDeathConnections[player] = nil
	end
end)
]]></ProtectedString>
