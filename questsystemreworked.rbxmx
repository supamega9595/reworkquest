					<ProtectedString name="Source"><![CDATA[-- Nightly quest templates.
-- NOTE: Rarity/Threat are assigned centrally at runtime by QuestService.

return {
	{
		Id = "daily_pages",
		Name = "Lost Pages",
		Description = "Scattered notes keep the spirits restless. Gather them before night deepens.",
		Objectives = {
			"Collect pages before dawn",
			"Work together - progress is shared",
		},
		Type = "SharedCollectCount",
		Settings = {
			PickupTag = "QuestPickup_Page",
		},
	},
	{
		Id = "capture_ring",
		Name = "Containment Ring",
		Description = "Hold the moving containment circle until full stabilization.",
		Objectives = {
			"Stand inside the moving ring to build progress",
			"Maintain control before dawn",
		},
		Type = "CaptureQuest",
		Settings = {
			GainRate = 1,
			ProgressTickInterval = 0.25,
			BurstCheckInterval = 20,
			BurstMultiplier = 2,
			BaseSpeed = 14,
			AccelTime = 1.25,
			DecelTime = 1.25,
			BaseRotationDegPerSecond = 20,
		},
	},
}
]]></ProtectedString>
