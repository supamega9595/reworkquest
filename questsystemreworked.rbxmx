		<Item class="LocalScript" referent="RBX10DDFFFF554648BB88B325E8F993AB0C">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local QuestSystem = ReplicatedStorage:WaitForChild("QuestSystem")
local Remotes = QuestSystem:WaitForChild("Remotes")
local ShowNightSummary = Remotes:WaitForChild("ShowNightSummary")

local gui = script.Parent
gui.Enabled = false

local OPEN_TIME = 0.2
local COUNT_DELAY = 0.25
local COUNT_DURATION = 1.0
local HOLD_DURATION = 8.0
local CLOSE_TIME = 0.2

local UI_CONFIG = {
	PanelWidth = 640,
	PanelHeight = 300,
	PanelPositionY = 0.37,
	PanelCornerRadius = 14,
	PanelPadding = {
		Top = 16,
		Bottom = 12,
		Left = 30,
		Right = 40,
	},
	LayoutSpacing = 8,
	TitleHeight = 28,
	SubtitleHeight = 16,
	InfoGroupHeight = 100,
	RewardGroupHeight = 80,
	ContentScale = 1.05,
	OutcomeRewardGap = 8,
	PatternImage = "rbxassetid://126294497128009",
	PatternTransparency = 0.9,
	PatternTileScale = 0.25,
	RewardTileWidth = 176,
	RewardTileHeight = 80,
	RewardTileTransparency = 0.28,
	PanelStrokeThickness = 2,
	PanelStrokeTransparency = 0.15,
}

local COLORS = {
	Gold = Color3.fromRGB(212, 175, 55),
	GoldSoft = Color3.fromRGB(197, 164, 50),
	Text = Color3.fromRGB(236, 232, 224),
	Muted = Color3.fromRGB(170, 165, 160),
	PanelTop = Color3.fromRGB(22, 19, 17),
	PanelBottom = Color3.fromRGB(10, 9, 8),
	Shadow = Color3.fromRGB(0, 0, 0),
	SurviveYes = Color3.fromRGB(120, 196, 140),
	SurviveNo = Color3.fromRGB(155, 138, 138),
	QuestNo = Color3.fromRGB(155, 138, 138),
}

local UI = {}
local sounds = {}
local countConnection
local footerLoopActive = false

local function ensureSound(name, soundId)
	if sounds[name] then
		return sounds[name]
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.Volume = 0.6
	sound.Parent = gui
	sounds[name] = sound
	return sound
end

local function formatNumber(value)
	local str = tostring(math.floor(value))
	local result = str:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	result = result:gsub("^,", "")
	return result
end

local function createText(parent, name, text, size, weight, color, alignment)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = Enum.Font.Gotham
	label.TextSize = size
	label.TextColor3 = color
	label.TextXAlignment = alignment or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.RichText = true
	label.Parent = parent
	return label
end

local function buildUi()
	if UI.Panel then
		return
	end

	local panel = Instance.new("Frame")
	panel.Name = "SummaryPanel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.new(0.5, 0, UI_CONFIG.PanelPositionY, 0)
	panel.Size = UDim2.new(0, UI_CONFIG.PanelWidth, 0, UI_CONFIG.PanelHeight)
	panel.BackgroundColor3 = COLORS.PanelBottom
	panel.BackgroundTransparency = 0
	panel.ClipsDescendants = true
	panel.Visible = false
	panel.ZIndex = 3
	panel.Parent = gui

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, UI_CONFIG.PanelCornerRadius)
	panelCorner.Parent = panel

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Name = "GoldOutline"
	panelStroke.Color = COLORS.Gold
	panelStroke.Thickness = UI_CONFIG.PanelStrokeThickness
	panelStroke.Transparency = UI_CONFIG.PanelStrokeTransparency
	panelStroke.Parent = panel

	local panelGradient = Instance.new("UIGradient")
	panelGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COLORS.PanelTop),
		ColorSequenceKeypoint.new(1, COLORS.PanelBottom),
	})
	panelGradient.Rotation = 90
	panelGradient.Parent = panel

	local pattern = Instance.new("ImageLabel")
	pattern.Name = "Pattern"
	pattern.BackgroundTransparency = 1
	pattern.Image = UI_CONFIG.PatternImage
	pattern.ImageTransparency = UI_CONFIG.PatternTransparency
	pattern.ScaleType = Enum.ScaleType.Tile
	pattern.TileSize = UDim2.new(UI_CONFIG.PatternTileScale, 0, UI_CONFIG.PatternTileScale, 0)
	pattern.Size = UDim2.new(1, 0, 1, 0)
	pattern.ZIndex = 2
	pattern.Parent = panel

	local panelScale = Instance.new("UIScale")
	panelScale.Scale = 0.05
	panelScale.Parent = panel

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Position = UDim2.new(0, UI_CONFIG.PanelPadding.Left, 0, UI_CONFIG.PanelPadding.Top)
	content.Size = UDim2.new(1, -(UI_CONFIG.PanelPadding.Left + UI_CONFIG.PanelPadding.Right), 1, -(UI_CONFIG.PanelPadding.Top + UI_CONFIG.PanelPadding.Bottom))
	content.ZIndex = 5
	content.Parent = panel

	local contentScale = Instance.new("UIScale")
	contentScale.Scale = UI_CONFIG.ContentScale
	contentScale.Parent = content

	local stack = Instance.new("UIListLayout")
	stack.Padding = UDim.new(0, UI_CONFIG.LayoutSpacing)
	stack.SortOrder = Enum.SortOrder.LayoutOrder
	stack.Parent = content

	local title = createText(content, "Title", "Night Summary", 26, Enum.FontWeight.Bold, COLORS.Gold, Enum.TextXAlignment.Left)
	title.Font = Enum.Font.GothamBold
	title.Size = UDim2.new(1, 0, 0, UI_CONFIG.TitleHeight)
	title.ZIndex = 5

	local subtitle = createText(content, "Subtitle", "Dawn breaks. Here's how the night went.", 13, Enum.FontWeight.Regular, COLORS.Muted, Enum.TextXAlignment.Left)
	subtitle.Size = UDim2.new(1, 0, 0, UI_CONFIG.SubtitleHeight)
	subtitle.TextTransparency = 0.15
	subtitle.ZIndex = 5

	local lateJoinWarning = createText(content, "LateJoinWarning", "Joined late - only distance credit", 20, Enum.FontWeight.Bold, Color3.fromRGB(235, 80, 80), Enum.TextXAlignment.Left)
	lateJoinWarning.Font = Enum.Font.GothamBold
	lateJoinWarning.Size = UDim2.new(1, 0, 0, 24)
	lateJoinWarning.Visible = false
	lateJoinWarning.ZIndex = 7
	UI.LateJoinWarning = lateJoinWarning

	local statusStack = Instance.new("Frame")
	statusStack.Name = "StatusStack"
	statusStack.BackgroundTransparency = 1
	statusStack.Size = UDim2.new(0, 190, 0, 44)
	statusStack.AnchorPoint = Vector2.new(1, 0)
	statusStack.Position = UDim2.new(1, -UI_CONFIG.PanelPadding.Right, 0, UI_CONFIG.PanelPadding.Top)
	statusStack.ZIndex = 9
	statusStack.Parent = panel

	local statusLayout = Instance.new("UIListLayout")
	statusLayout.Padding = UDim.new(0, 2)
	statusLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	statusLayout.SortOrder = Enum.SortOrder.LayoutOrder
	statusLayout.Parent = statusStack

	local statusLabel = createText(statusStack, "StatusLabel", "Returning at dawn…", 14, Enum.FontWeight.SemiBold, COLORS.Muted, Enum.TextXAlignment.Right)
	statusLabel.Size = UDim2.new(1, 0, 0, 20)
	statusLabel.TextTransparency = 0.2
	statusLabel.ZIndex = 9

	local countdownLabel = createText(statusStack, "CountdownLabel", "Closing in 04s", 16, Enum.FontWeight.Bold, COLORS.Text, Enum.TextXAlignment.Right)
	countdownLabel.Size = UDim2.new(1, 0, 0, 22)
	countdownLabel.ZIndex = 9
	UI.StatusLabel = statusLabel
	UI.CountdownLabel = countdownLabel

	local outcomeContainer = Instance.new("Frame")
	outcomeContainer.Name = "OutcomeContainer"
	outcomeContainer.BackgroundColor3 = Color3.fromRGB(20, 18, 16)
	outcomeContainer.BackgroundTransparency = 0.4
	outcomeContainer.Size = UDim2.new(1, 0, 0, UI_CONFIG.InfoGroupHeight)
	outcomeContainer.ZIndex = 5
	outcomeContainer.Parent = content

	local gap = Instance.new("Frame")
	gap.Name = "OutcomeRewardGap"
	gap.BackgroundTransparency = 1
	gap.Size = UDim2.new(1, 0, 0, UI_CONFIG.OutcomeRewardGap)
	gap.ZIndex = 5
	gap.Parent = content

	local outcomeCorner = Instance.new("UICorner")
	outcomeCorner.CornerRadius = UDim.new(0, 10)
	outcomeCorner.Parent = outcomeContainer

	local infoGroup = Instance.new("Frame")
	infoGroup.Name = "InfoGroup"
	infoGroup.BackgroundTransparency = 1
	infoGroup.Size = UDim2.new(1, -20, 1, -16)
	infoGroup.Position = UDim2.new(0, 10, 0, 8)
	infoGroup.ZIndex = 6
	infoGroup.Parent = outcomeContainer

	local infoLayout = Instance.new("UIListLayout")
	infoLayout.Padding = UDim.new(0, 10)
	infoLayout.SortOrder = Enum.SortOrder.LayoutOrder
	infoLayout.Parent = infoGroup

	local function createInfoRow(labelText)
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 24)
		row.Parent = infoGroup

		local label = createText(row, "Label", labelText, 17, Enum.FontWeight.Medium, COLORS.GoldSoft, Enum.TextXAlignment.Left)
		label.Size = UDim2.new(0.6, 0, 1, 0)
		label.ZIndex = 6

		return row, label
	end

	local function createChip(parent)
		local chip = Instance.new("Frame")
		chip.Name = "Chip"
		chip.BackgroundColor3 = Color3.fromRGB(32, 30, 28)
		chip.BackgroundTransparency = 0
		chip.Size = UDim2.new(0, 60, 0, 20)
		chip.AnchorPoint = Vector2.new(1, 0.5)
		chip.Position = UDim2.new(1, 0, 0.5, 0)
		chip.ZIndex = 7
		chip.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = chip

		local text = createText(chip, "ChipText", "YES", 12, Enum.FontWeight.Bold, COLORS.Text, Enum.TextXAlignment.Center)
		text.Size = UDim2.new(1, 0, 1, 0)
		text.ZIndex = 8
		text.Font = Enum.Font.GothamBold
		return chip, text
	end

	local survivedRow = createInfoRow("Survived")
	UI.SurvivedChip, UI.SurvivedValue = createChip(survivedRow)

	local questRow = createInfoRow("Quest Completed")
	UI.QuestChip, UI.QuestValue = createChip(questRow)

	local distanceRow = createInfoRow("Distance")
	UI.DistanceValue = createText(distanceRow, "DistanceValue", "--", 20, Enum.FontWeight.SemiBold, COLORS.Text, Enum.TextXAlignment.Right)
		UI.DistanceValue.Size = UDim2.new(0.4, 0, 1, 0)
		UI.DistanceValue.Position = UDim2.new(0.6, 0, 0, 0)
		UI.DistanceValue.ZIndex = 7

	local rewardGroup = Instance.new("Frame")
	rewardGroup.Name = "RewardGroup"
	rewardGroup.BackgroundTransparency = 1
	rewardGroup.Size = UDim2.new(1, 0, 0, UI_CONFIG.RewardGroupHeight)
	rewardGroup.ZIndex = 5
	rewardGroup.Parent = content

	local rewardLayout = Instance.new("UIListLayout")
	rewardLayout.FillDirection = Enum.FillDirection.Horizontal
	rewardLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rewardLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rewardLayout.Padding = UDim.new(0, 10)
	rewardLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rewardLayout.Parent = rewardGroup

	local function createRewardTile(name, labelText)
		local tile = Instance.new("Frame")
		tile.Name = name
		tile.BackgroundColor3 = Color3.fromRGB(24, 21, 19)
		tile.BackgroundTransparency = UI_CONFIG.RewardTileTransparency
		tile.Size = UDim2.new(0, UI_CONFIG.RewardTileWidth, 0, UI_CONFIG.RewardTileHeight)
		tile.ZIndex = 6
		tile.Parent = rewardGroup

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = tile

		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(120, 103, 54)
		stroke.Transparency = 0.7
		stroke.Thickness = 1
		stroke.Parent = tile

		local label = createText(tile, "Label", labelText, 12, Enum.FontWeight.SemiBold, COLORS.Muted, Enum.TextXAlignment.Center)
		label.Position = UDim2.new(0, 0, 0, 10)
		label.Size = UDim2.new(1, 0, 0, 16)
		label.ZIndex = 7

		local value = createText(tile, "Value", "+0", 24, Enum.FontWeight.Bold, COLORS.Text, Enum.TextXAlignment.Center)
		value.Font = Enum.Font.GothamBold
		value.Position = UDim2.new(0, 0, 0, 34)
		value.Size = UDim2.new(1, 0, 0, 38)
		value.ZIndex = 7

		local accent = Instance.new("Frame")
		accent.Name = "Accent"
		accent.BackgroundColor3 = COLORS.Gold
		accent.BackgroundTransparency = 0.7
		accent.Size = UDim2.new(0.3, 0, 0, 2)
		accent.Position = UDim2.new(0.35, 0, 1, -8)
		accent.ZIndex = 7
		accent.Parent = tile

		return value
	end

	UI.CashValue = createRewardTile("CashTile", "CASH")
	UI.XPValue = createRewardTile("XPTile", "XP")
	UI.WinsValue = createRewardTile("WinsTile", "WINS")

	UI.Panel = panel
	UI.PanelScale = panelScale
end

local function setTextAlpha(alpha)
	for _, element in pairs(UI) do
		if typeof(element) == "Instance" then
			for _, child in ipairs(element:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextTransparency = alpha
				end
			end
		end
	end
end

local function tweenScale(target, easingStyle, easingDirection, duration)
	local tween = TweenService:Create(UI.PanelScale, TweenInfo.new(duration, easingStyle, easingDirection), {Scale = target})
	tween:Play()
	return tween
end

local function stopCountConnection()
	if countConnection then
		countConnection:Disconnect()
		countConnection = nil
	end
end

local function pulseQuestValue()
	local scale = UI.QuestValue:FindFirstChild("PulseScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "PulseScale"
		scale.Parent = UI.QuestValue
	end
	scale.Scale = 1
	local tweenOut = TweenService:Create(scale, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1.06})
	local tweenIn = TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 1})
	tweenOut:Play()
	tweenOut.Completed:Connect(function()
		tweenIn:Play()
	end)
end

local function startFooterDots()
	if footerLoopActive then
		return
	end
	footerLoopActive = true
	task.spawn(function()
		local dots = {"", ".", "..", "..."}
		local index = 1
		while footerLoopActive do
			if UI.StatusLabel then
				UI.StatusLabel.Text = "Returning at dawn" .. dots[index]
			end
			index = index % #dots + 1
			task.wait(0.4)
		end
	end)
end

local function stopFooterDots()
	footerLoopActive = false
end

	local function startCountdown(seconds)
	if not UI.CountdownLabel then
		return
	end
	task.spawn(function()
		local start = os.clock()
		while footerLoopActive do
			local elapsed = os.clock() - start
			local remaining = math.max(0, math.ceil(seconds - elapsed))
			UI.CountdownLabel.Text = string.format("Closing in %02ds", remaining)
			if remaining <= 0 then
				break
			end
			task.wait(1)
		end
	end)
end

local function showSummary(data)
	buildUi()
	gui.Enabled = true
	UI.Panel.Visible = true
	UI.PanelScale.Scale = 0.05
	setTextAlpha(0)
	startFooterDots()
	startCountdown(COUNT_DELAY + COUNT_DURATION + HOLD_DURATION)

	local survived = data and data.Survived
	local completed = data and data.QuestCompleted
	local distance = data and (data.DistanceStuds or data.Distance) or 0
	local cashEarned = data and (data.CashEarned or data.CashAwarded) or 0
	local xpEarned = data and (data.XPEarned or data.XPAwarded) or 0
	local winsEarned = data and (data.WinsEarned or data.WinsAwarded) or 0
	local joinedLate = data and data.JoinedLate == true
	if UI.LateJoinWarning then
		UI.LateJoinWarning.Visible = joinedLate
	end

	UI.SurvivedValue.Text = survived and "YES" or "NO"
	UI.SurvivedValue.TextColor3 = Color3.fromRGB(245, 245, 245)
	UI.SurvivedChip.BackgroundColor3 = survived and Color3.fromRGB(46, 76, 58) or Color3.fromRGB(70, 64, 64)

	UI.QuestValue.Text = completed and "YES" or "NO"
	UI.QuestValue.TextColor3 = Color3.fromRGB(245, 245, 245)
	UI.QuestChip.BackgroundColor3 = completed and Color3.fromRGB(90, 74, 35) or Color3.fromRGB(70, 64, 64)

	UI.DistanceValue.Text = string.format("<font size='21'>%s</font> <font size='13' color='#b6b0a8'>studs</font>", formatNumber(distance))
	UI.DistanceValue.TextColor3 = COLORS.Text

	UI.CashValue.Text = "+0"
	UI.XPValue.Text = "+0"
	UI.WinsValue.Text = "+0"

	local openTween = tweenScale(1, Enum.EasingStyle.Back, Enum.EasingDirection.Out, OPEN_TIME)

	openTween.Completed:Connect(function()
		ensureSound("OpenSound", "rbxassetid://76917399147672"):Play()
		if completed then
			pulseQuestValue()
		end
		task.delay(COUNT_DELAY, function()
			local countSound = ensureSound("CountSound", "rbxassetid://140677742495553")
			countSound:Play()
			local start = os.clock()
			stopCountConnection()
			countConnection = RunService.RenderStepped:Connect(function()
				local elapsed = os.clock() - start
				local alpha = math.clamp(elapsed / COUNT_DURATION, 0, 1)
				local cashValue = math.floor(cashEarned * alpha)
				local xpValue = math.floor(xpEarned * alpha)
				local winsValue = math.floor(winsEarned * alpha)
				UI.CashValue.Text = "+" .. formatNumber(cashValue)
				UI.XPValue.Text = "+" .. formatNumber(xpValue)
				UI.WinsValue.Text = "+" .. formatNumber(winsValue)
				if alpha >= 1 then
					stopCountConnection()
					countSound:Stop()
					task.delay(HOLD_DURATION, function()
						local closeSound = ensureSound("CloseSound", "rbxassetid://73730549515939")
						closeSound:Play()
						local closeTween = tweenScale(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.In, CLOSE_TIME)
						closeTween.Completed:Connect(function()
							stopFooterDots()
							UI.Panel.Visible = false
							gui.Enabled = false
						end)
					end)
				end
			end)
		end)
	end)
end

ShowNightSummary.OnClientEvent:Connect(showSummary)]]></ProtectedString>
