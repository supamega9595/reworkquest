				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local RarityConfig = {
	RarityOrder = {"Common", "Uncommon", "Rare", "Epic", "Legendary"},

	Rarities = {
		Common = {
			DisplayName = "Common",
			DefaultThreat = 20,
			Theme = {
				Accent = Color3.fromRGB(200, 200, 200),
				BgTop = Color3.fromRGB(24, 24, 24),
				BgBottom = Color3.fromRGB(12, 12, 12),
				Stroke = Color3.fromRGB(70, 70, 70),
			},
			Effects = { GradientDrift = false, Pulse = false, Shimmer = false },
		},
		Uncommon = {
			DisplayName = "Uncommon",
			DefaultThreat = 35,
			Theme = {
				Accent = Color3.fromRGB(125, 214, 123),
				BgTop = Color3.fromRGB(20, 34, 20),
				BgBottom = Color3.fromRGB(9, 18, 9),
				Stroke = Color3.fromRGB(92, 150, 90),
			},
			Effects = { GradientDrift = false, Pulse = false, Shimmer = false },
		},
		Rare = {
			DisplayName = "Rare",
			DefaultThreat = 45,
			Theme = {
				Accent = Color3.fromRGB(109, 165, 255),
				BgTop = Color3.fromRGB(18, 30, 52),
				BgBottom = Color3.fromRGB(8, 14, 26),
				Stroke = Color3.fromRGB(80, 118, 180),
			},
			Effects = { GradientDrift = true, Pulse = false, Shimmer = false },
		},
		Epic = {
			DisplayName = "Epic",
			DefaultThreat = 55,
			Theme = {
				Accent = Color3.fromRGB(162, 92, 255),
				BgTop = Color3.fromRGB(34, 18, 52),
				BgBottom = Color3.fromRGB(14, 8, 26),
				Stroke = Color3.fromRGB(124, 79, 180),
			},
			Effects = { GradientDrift = true, Pulse = true, Shimmer = false },
		},
		Legendary = {
			DisplayName = "Legendary",
			DefaultThreat = 85,
			Theme = {
				Accent = Color3.fromRGB(255, 190, 92),
				BgTop = Color3.fromRGB(50, 30, 12),
				BgBottom = Color3.fromRGB(18, 10, 4),
				Stroke = Color3.fromRGB(255, 195, 120),
			},
			Effects = { GradientDrift = true, Pulse = true, Shimmer = true },
		},
	},
}

function RarityConfig.getThreatTier(threat)
	if threat >= 75 then
		return "EXTREME"
	elseif threat >= 50 then
		return "HIGH"
	elseif threat >= 25 then
		return "MED"
	end
	return "LOW"
end

return RarityConfig
]]></ProtectedString>
