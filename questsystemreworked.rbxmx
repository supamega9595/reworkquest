	<Item class="ScreenGui" referent="RBXDBE8951912FA4E49B06AFC5212D4FB42">
		<Properties>
			<bool name="ClipToDeviceSafeArea">true</bool>
			<int name="DisplayOrder">10</int>
			<token name="SafeAreaCompatibility">1</token>
